                                           rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                           rdfs:range <https://w3id.org/quay/VerificationMethod> ;
                                           <http://purl.obolibrary.org/obo/IAO_0000115> "Relates a yield description to the mechanism used to verify data integrity after transfer." ;
                                           rdfs:label "verification method" .


