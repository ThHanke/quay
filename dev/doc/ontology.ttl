                                               rdfs:range xsd:duration ;
                                               <http://purl.obolibrary.org/obo/IAO_0000115> "Maximum acceptable duration of data loss measured as a time window before the disruption." ;
                                               rdfs:label "recovery point objective" .


###  https://w3id.org/quay/recoveryTimeObjective
<https://w3id.org/quay/recoveryTimeObjective> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                              rdfs:range xsd:duration ;
                                              <http://purl.obolibrary.org/obo/IAO_0000115> "Maximum acceptable duration to restore service after a disruption." ;
                                              rdfs:label "recovery time objective" .


###  https://w3id.org/quay/replicationFactor
<https://w3id.org/quay/replicationFactor> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                          rdfs:range xsd:nonNegativeInteger ;
                                          <http://purl.obolibrary.org/obo/IAO_0000115> "Number of independent copies of the data maintained across storage nodes." ;
                                          rdfs:label "replication factor" .


###  https://w3id.org/quay/retentionPeriod
<https://w3id.org/quay/retentionPeriod> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <http://www.w3.org/ns/dcat#Distribution> ;
                                        rdfs:range xsd:duration ;
                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Duration for which data is guaranteed to be retained before deletion or archival." ;
                                        rdfs:label "retention period" .


###  https://w3id.org/quay/uptimePercentage
<https://w3id.org/quay/uptimePercentage> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                         rdfs:range xsd:decimal ;
                                         <http://purl.obolibrary.org/obo/IAO_0000115> "Percentage of time the service is operational and accessible, expressed as a decimal value between 0 and 100." ;
                                         rdfs:label "uptime percentage" .


