#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/quay/AccessDescription>
                <https://w3id.org/quay/AuthenticationScheme>
                <https://w3id.org/quay/Coverage>
                <https://w3id.org/quay/DeliveryMode>
                <https://w3id.org/quay/EncryptionAlgorithm>
                <https://w3id.org/quay/Operation>
                <https://w3id.org/quay/Protocol>
                <https://w3id.org/quay/ServiceQuality>
                <https://w3id.org/quay/TemporalQuality>
                <https://w3id.org/quay/VerificationMethod>
                <https://w3id.org/quay/YieldDescription>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/quay/AccessDescription>
                <https://w3id.org/quay/AuthenticationScheme>
                <https://w3id.org/quay/Coverage>
                <https://w3id.org/quay/DeliveryMode>
                <https://w3id.org/quay/Operation>
                <https://w3id.org/quay/Protocol>
                <https://w3id.org/quay/ServiceQuality>
                <https://w3id.org/quay/TemporalQuality>
                <https://w3id.org/quay/VerificationMethod>
                <https://w3id.org/quay/YieldDescription>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/quay/Aes128Encryption>
                <https://w3id.org/quay/Aes256Encryption>
                <https://w3id.org/quay/GpgEncryption>
                <https://w3id.org/quay/NoEncryption>
                <https://w3id.org/quay/SshEncryption>
                <https://w3id.org/quay/Tls12Encryption>
                <https://w3id.org/quay/Tls13Encryption>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/quay/ApiKeyAuthentication>
                <https://w3id.org/quay/AwsCredentialAuthentication>
                <https://w3id.org/quay/BasicAuthentication>
                <https://w3id.org/quay/GpgKeyAuthentication>
                <https://w3id.org/quay/NoAuthentication>
                <https://w3id.org/quay/OAuth2Authentication>
                <https://w3id.org/quay/SshKeyAuthentication>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/quay/Archived>
                <https://w3id.org/quay/RealTime>
                <https://w3id.org/quay/Snapshot>
                <https://w3id.org/quay/Versioned>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/quay/BestEffort>
                <https://w3id.org/quay/Distributed>
                <https://w3id.org/quay/HighAvailability>
                <https://w3id.org/quay/SingleHost>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://w3id.org/quay/BitTorrentProtocol>
                <https://w3id.org/quay/FtpProtocol>
                <https://w3id.org/quay/GitProtocol>
                <https://w3id.org/quay/HookProtocol>
                <https://w3id.org/quay/HttpProtocol>
                <https://w3id.org/quay/IpfsProtocol>
