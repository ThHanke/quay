###  https://w3id.org/quay/AccessDescription
<https://w3id.org/quay/AccessDescription> rdf:type owl:Class ;
                                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://w3id.org/quay/authenticationScheme> ;
                                                            owl:someValuesFrom <https://w3id.org/quay/AuthenticationScheme>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://w3id.org/quay/protocol> ;
                                                            owl:someValuesFrom <https://w3id.org/quay/Protocol>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://w3id.org/quay/supportedOperation> ;
                                                            owl:someValuesFrom <https://w3id.org/quay/Operation>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://w3id.org/quay/protocol> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass <https://w3id.org/quay/Protocol>
                                                          ] ;
                                          <http://purl.obolibrary.org/obo/IAO_0000115> "Qualification node that specifies how a distribution is reached, comprising exactly one protocol, at least one authentication scheme, and at least one supported operation." ;
                                          rdfs:comment "Qualifies HOW a Distribution is reached." ;
                                          rdfs:label "Access Description" .


###  https://w3id.org/quay/Aes128Encryption
<https://w3id.org/quay/Aes128Encryption> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/quay/EncryptionAlgorithm> ;
                                         <http://purl.obolibrary.org/obo/IAO_0000115> "Encryption using the Advanced Encryption Standard with a 128-bit key." ;
                                         rdfs:comment "128-bit Advanced Encryption Standard." ;
                                         rdfs:label "AES-128 Encryption" .


###  https://w3id.org/quay/Aes256Encryption
<https://w3id.org/quay/Aes256Encryption> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/quay/EncryptionAlgorithm> ;
                                         <http://purl.obolibrary.org/obo/IAO_0000115> "Encryption using the Advanced Encryption Standard with a 256-bit key." ;
                                         rdfs:comment "256-bit Advanced Encryption Standard." ;
                                         rdfs:label "AES-256 Encryption" .


###  https://w3id.org/quay/ApiKeyAuthentication
<https://w3id.org/quay/ApiKeyAuthentication> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/quay/AuthenticationScheme> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Authentication scheme that verifies identity by presenting a pre-shared secret key with each request." ;
                                             rdfs:label "API Key" ,
                                                        "API Key Authentication" .


###  https://w3id.org/quay/Archived
<https://w3id.org/quay/Archived> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/quay/TemporalQuality> ;
                                 <http://purl.obolibrary.org/obo/IAO_0000115> "Temporal quality in which data is preserved for long-term retention and is no longer actively updated." ;
                                 rdfs:label "Archived" .


###  https://w3id.org/quay/AuthenticationScheme
<https://w3id.org/quay/AuthenticationScheme> rdf:type owl:Class ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Method used to verify the identity of an agent requesting access to a data resource." ;
                                             rdfs:label "Authentication Scheme" .


###  https://w3id.org/quay/AwsCredentialAuthentication
<https://w3id.org/quay/AwsCredentialAuthentication> rdf:type owl:Class ;
                                                    rdfs:subClassOf <https://w3id.org/quay/AuthenticationScheme> ;
                                                    <http://purl.obolibrary.org/obo/IAO_0000115> "Authentication scheme that verifies identity using an AWS access key identifier and secret access key pair." ;
                                                    rdfs:label "AWS Credential" ,
                                                               "AWS Credential Authentication" .


###  https://w3id.org/quay/BasicAuthentication
<https://w3id.org/quay/BasicAuthentication> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/quay/AuthenticationScheme> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Authentication scheme that verifies identity by transmitting a username and password pair, typically Base64-encoded." ;
                                            rdfs:label "Basic Authentication" .


###  https://w3id.org/quay/BestEffort
<https://w3id.org/quay/BestEffort> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/quay/ServiceQuality> ;
                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Service quality in which availability depends on upstream network and server conditions without formal guarantees." ;
                                   rdfs:comment "Quality depends on upstream server or network conditions." ;
                                   rdfs:label "Best Effort" .


###  https://w3id.org/quay/BitTorrentProtocol
<https://w3id.org/quay/BitTorrentProtocol> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/quay/Protocol> ;
                                           <http://purl.obolibrary.org/obo/IAO_0000115> "Protocol that distributes data across a swarm of peers using piece-based transfer and a distributed hash table for coordination." ;
                                           rdfs:label "BitTorrent" ,
                                                      "BitTorrent Protocol" .


###  https://w3id.org/quay/BulkDelivery
<https://w3id.org/quay/BulkDelivery> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/quay/DeliveryMode> ;
                                     <http://purl.obolibrary.org/obo/IAO_0000115> "Delivery mode in which data is transferred as a complete unit within a single transaction." ;
                                     rdfs:label "Bulk Delivery" .


###  https://w3id.org/quay/CompleteCoverage
<https://w3id.org/quay/CompleteCoverage> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/quay/Coverage> ;
                                         <http://purl.obolibrary.org/obo/IAO_0000115> "Coverage in which the distribution contains the entirety of the available data of its dataset." ;
                                         rdfs:label "Complete" ,
                                                    "Complete Coverage" .


###  https://w3id.org/quay/ContentAddressing
<https://w3id.org/quay/ContentAddressing> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/quay/VerificationMethod> ;
                                          <http://purl.obolibrary.org/obo/IAO_0000115> "Verification method in which data is both identified and verified by a hash derived from its content, such that the identifier itself proves integrity." ;
                                          rdfs:comment "Content identified and verified by its hash, as in IPFS CIDs." ;
                                          rdfs:label "Content Addressing" .


###  https://w3id.org/quay/Coverage
<https://w3id.org/quay/Coverage> rdf:type owl:Class ;
                                 <http://purl.obolibrary.org/obo/IAO_0000115> "Characterisation of the extent to which a distribution represents the total available data of a dataset." ;
                                 rdfs:label "Coverage" .


###  https://w3id.org/quay/DeleteOperation
<https://w3id.org/quay/DeleteOperation> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/quay/Operation> ;
                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Operation that permanently removes data from a data resource." ;
                                        rdfs:label "Delete" ,
                                                   "Delete Operation" .


###  https://w3id.org/quay/DeliveryMode
<https://w3id.org/quay/DeliveryMode> rdf:type owl:Class ;
                                     <http://purl.obolibrary.org/obo/IAO_0000115> "Mechanism by which data is transferred from a data resource to a consuming agent." ;
                                     rdfs:label "Delivery Mode" .


###  https://w3id.org/quay/DigitalSignature
<https://w3id.org/quay/DigitalSignature> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/quay/VerificationMethod> ;
                                         <http://purl.obolibrary.org/obo/IAO_0000115> "Verification method that confirms both integrity and authenticity of data by validating a cryptographic signature produced by a known key holder." ;
                                         rdfs:comment "Integrity and authenticity verified via cryptographic signature." ;
                                         rdfs:label "Digital Signature" .


###  https://w3id.org/quay/Distributed
<https://w3id.org/quay/Distributed> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/quay/ServiceQuality> ;
                                    <http://purl.obolibrary.org/obo/IAO_0000115> "Service quality in which data is replicated across multiple independent nodes for fault tolerance." ;
                                    rdfs:comment "Data distributed across multiple peers or nodes." ;
                                    rdfs:label "Distributed" .


###  https://w3id.org/quay/EncryptionAlgorithm
<https://w3id.org/quay/EncryptionAlgorithm> rdf:type owl:Class ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Cryptographic algorithm or protocol used to protect data confidentiality, either at rest or in transit." ;
                                            rdfs:label "Encryption Algorithm" .


###  https://w3id.org/quay/EventDrivenDelivery
<https://w3id.org/quay/EventDrivenDelivery> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/quay/DeliveryMode> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Delivery mode in which data transfer is triggered by the occurrence of discrete events or state changes." ;
                                            rdfs:label "Event-Driven Delivery" .


###  https://w3id.org/quay/FtpProtocol
<https://w3id.org/quay/FtpProtocol> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/quay/Protocol> ;
                                    <http://purl.obolibrary.org/obo/IAO_0000115> "Protocol that transfers files between client and server using the File Transfer Protocol." ;
                                    rdfs:label "FTP" ,
                                               "FTP Protocol" .


###  https://w3id.org/quay/GitProtocol
<https://w3id.org/quay/GitProtocol> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/quay/Protocol> ;
                                    <http://purl.obolibrary.org/obo/IAO_0000115> "Protocol that accesses version-controlled data through the Git distributed version control system." ;
                                    rdfs:label "Git" ,
                                               "Git Protocol" .


###  https://w3id.org/quay/GpgEncryption
