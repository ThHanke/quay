@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix quay: <https://w3id.org/quay/>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.

# =============================================
# QUAY: Qualified Usage, Access and Yield
# A DCAT Profile for Data Access, Storage
# and Authorization Metadata
# =============================================

# === Core Qualification Classes ===

quay:AccessDescription a owl:Class;
    rdfs:comment "Qualifies HOW a Distribution is reached.";
    rdfs:label "Access Description".

quay:YieldDescription a owl:Class;
    rdfs:comment "Qualifies WHAT a Distribution delivers.";
    rdfs:label "Yield Description".

# === Protocol Hierarchy ===

quay:Protocol a owl:Class;
    rdfs:label "Protocol".

quay:HttpProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "HTTP Protocol".

quay:S3Protocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "S3 Protocol".

quay:RsyncProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "Rsync Protocol".

quay:WebDavProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "WebDAV Protocol".

quay:SshProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "SSH Protocol".

quay:BitTorrentProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "BitTorrent Protocol".

quay:IpfsProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "IPFS Protocol".

quay:LocalFilesystemProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "Local Filesystem Protocol".

quay:RcloneProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "Rclone Protocol".

quay:FtpProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "FTP Protocol".

quay:GitProtocol a owl:Class;
    rdfs:subClassOf quay:Protocol;
    rdfs:label "Git Protocol".

# === Authentication Scheme Hierarchy ===

quay:AuthenticationScheme a owl:Class;
    rdfs:label "Authentication Scheme".

quay:NoAuthentication a owl:Class;
    rdfs:subClassOf quay:AuthenticationScheme;
    rdfs:label "No Authentication".

quay:ApiKeyAuthentication a owl:Class;
    rdfs:subClassOf quay:AuthenticationScheme;
    rdfs:label "API Key Authentication".

quay:OAuth2Authentication a owl:Class;
    rdfs:subClassOf quay:AuthenticationScheme;
    rdfs:label "OAuth2 Authentication".

quay:BasicAuthentication a owl:Class;
    rdfs:subClassOf quay:AuthenticationScheme;
    rdfs:label "Basic Authentication".

quay:SshKeyAuthentication a owl:Class;
    rdfs:subClassOf quay:AuthenticationScheme;
    rdfs:label "SSH Key Authentication".

quay:GpgKeyAuthentication a owl:Class;
    rdfs:subClassOf quay:AuthenticationScheme;
    rdfs:label "GPG Key Authentication".

quay:AwsCredentialAuthentication a owl:Class;
    rdfs:subClassOf quay:AuthenticationScheme;
    rdfs:label "AWS Credential Authentication".

# === Operation Hierarchy ===

quay:Operation a owl:Class;
    rdfs:label "Operation".

quay:ReadOperation a owl:Class;
    rdfs:subClassOf quay:Operation;
    rdfs:label "Read Operation".

quay:WriteOperation a owl:Class;
    rdfs:subClassOf quay:Operation;
    rdfs:label "Write Operation".

quay:DeleteOperation a owl:Class;
    rdfs:subClassOf quay:Operation;
    rdfs:label "Delete Operation".

quay:ListOperation a owl:Class;
    rdfs:subClassOf quay:Operation;
    rdfs:label "List Operation".

quay:ReplicateOperation a owl:Class;
    rdfs:subClassOf quay:Operation;
    rdfs:label "Replicate Operation".

# === Yield: Delivery Mode ===

quay:DeliveryMode a owl:Class;
    rdfs:label "Delivery Mode".

quay:BulkDelivery a owl:Class;
    rdfs:subClassOf quay:DeliveryMode;
    rdfs:label "Bulk Delivery".

quay:StreamingDelivery a owl:Class;
    rdfs:subClassOf quay:DeliveryMode;
    rdfs:label "Streaming Delivery".

quay:PaginatedDelivery a owl:Class;
    rdfs:subClassOf quay:DeliveryMode;
    rdfs:label "Paginated Delivery".

quay:EventDrivenDelivery a owl:Class;
    rdfs:subClassOf quay:DeliveryMode;
    rdfs:label "Event-Driven Delivery".

# === Yield: Temporal Quality ===

quay:TemporalQuality a owl:Class;
    rdfs:label "Temporal Quality".

quay:RealTime a owl:Class;
    rdfs:subClassOf quay:TemporalQuality;
    rdfs:label "Real-Time".

quay:Snapshot a owl:Class;
    rdfs:subClassOf quay:TemporalQuality;
    rdfs:label "Snapshot".

quay:Archived a owl:Class;
    rdfs:subClassOf quay:TemporalQuality;
    rdfs:label "Archived".

quay:Versioned a owl:Class;
    rdfs:subClassOf quay:TemporalQuality;
    rdfs:label "Versioned".

# === Yield: Coverage ===

quay:Coverage a owl:Class;
    rdfs:label "Coverage".

quay:CompleteCoverage a owl:Class;
    rdfs:subClassOf quay:Coverage;
    rdfs:label "Complete Coverage".

quay:SubsetCoverage a owl:Class;
    rdfs:subClassOf quay:Coverage;
    rdfs:label "Subset Coverage".

quay:SampleCoverage a owl:Class;
    rdfs:subClassOf quay:Coverage;
    rdfs:label "Sample Coverage".

quay:IncrementalCoverage a owl:Class;
    rdfs:subClassOf quay:Coverage;
    rdfs:label "Incremental Coverage".

# === Yield: Service Quality & Verification ===

quay:ServiceQuality a owl:Class;
    rdfs:label "Service Quality".

quay:VerificationMethod a owl:Class;
    rdfs:label "Verification Method".

# === Object Properties ===

quay:accessDescription a owl:ObjectProperty;
    rdfs:label "access description";
    rdfs:domain dcat:Distribution;
    rdfs:range quay:AccessDescription.

quay:yieldDescription a owl:ObjectProperty;
    rdfs:label "yield description";
    rdfs:domain dcat:Distribution;
    rdfs:range quay:YieldDescription.

quay:protocol a owl:ObjectProperty;
    rdfs:label "protocol";
    rdfs:domain quay:AccessDescription;
    rdfs:range quay:Protocol.

quay:authenticationScheme a owl:ObjectProperty;
    rdfs:label "authentication scheme";
    rdfs:domain quay:AccessDescription;
    rdfs:range quay:AuthenticationScheme.

quay:supportedOperation a owl:ObjectProperty;
    rdfs:label "supported operation";
    rdfs:domain quay:AccessDescription;
    rdfs:range quay:Operation.

quay:deliveryMode a owl:ObjectProperty;
    rdfs:label "delivery mode";
    rdfs:domain quay:YieldDescription;
    rdfs:range quay:DeliveryMode.

quay:temporalQuality a owl:ObjectProperty;
    rdfs:label "temporal quality";
    rdfs:domain quay:YieldDescription;
    rdfs:range quay:TemporalQuality.

quay:coverage a owl:ObjectProperty;
    rdfs:label "coverage";
    rdfs:domain quay:YieldDescription;
    rdfs:range quay:Coverage.

quay:serviceQuality a owl:ObjectProperty;
    rdfs:label "service quality";
    rdfs:domain quay:YieldDescription;
    rdfs:range quay:ServiceQuality.

quay:verificationMethod a owl:ObjectProperty;
    rdfs:label "verification method";
    rdfs:domain quay:YieldDescription;
    rdfs:range quay:VerificationMethod.

# === Encryption Object Properties ===

quay:encryptionAtRest a owl:ObjectProperty;
    rdfs:label "encryption at rest";
    rdfs:domain dcat:Distribution;
    rdfs:range quay:EncryptionAlgorithm.

quay:encryptionInTransit a owl:ObjectProperty;
    rdfs:label "encryption in transit";
    rdfs:domain dcat:Distribution;
    rdfs:range quay:EncryptionAlgorithm.

quay:checksum a owl:DatatypeProperty;
    rdfs:label "checksum";
    rdfs:domain dcat:Distribution;
    rdfs:range xsd:string.

quay:checksumAlgorithm a owl:DatatypeProperty;
    rdfs:label "checksum algorithm";
    rdfs:domain dcat:Distribution;
    rdfs:range xsd:string.

# =============================================
# Logical Axioms
# =============================================

# === Disjointness: Core qualification classes ===

quay:AccessDescription owl:disjointWith quay:YieldDescription.

# === Disjointness: Top-level category classes ===

[] a owl:AllDisjointClasses;
    owl:members (quay:AccessDescription quay:YieldDescription quay:Protocol
                 quay:AuthenticationScheme quay:Operation quay:DeliveryMode
                 quay:TemporalQuality quay:Coverage quay:ServiceQuality
                 quay:VerificationMethod).

# === Disjointness: Protocol subclasses ===

[] a owl:AllDisjointClasses;
    owl:members (quay:HttpProtocol quay:S3Protocol quay:RsyncProtocol
                 quay:WebDavProtocol quay:SshProtocol quay:BitTorrentProtocol
                 quay:IpfsProtocol quay:LocalFilesystemProtocol quay:RcloneProtocol
                 quay:FtpProtocol quay:GitProtocol).

# === Disjointness: AuthScheme subclasses ===

[] a owl:AllDisjointClasses;
    owl:members (quay:NoAuthentication quay:ApiKeyAuthentication quay:OAuth2Authentication
                 quay:BasicAuthentication quay:SshKeyAuthentication quay:GpgKeyAuthentication
                 quay:AwsCredentialAuthentication).

# === Disjointness: Operation subclasses ===

[] a owl:AllDisjointClasses;
    owl:members (quay:ReadOperation quay:WriteOperation quay:DeleteOperation
                 quay:ListOperation quay:ReplicateOperation).

# === Disjointness: DeliveryMode subclasses ===

[] a owl:AllDisjointClasses;
    owl:members (quay:BulkDelivery quay:StreamingDelivery quay:PaginatedDelivery
                 quay:EventDrivenDelivery).

# === Disjointness: TemporalQuality subclasses ===

[] a owl:AllDisjointClasses;
    owl:members (quay:RealTime quay:Snapshot quay:Archived
                 quay:Versioned).

# === Disjointness: Coverage subclasses ===

[] a owl:AllDisjointClasses;
    owl:members (quay:CompleteCoverage quay:SubsetCoverage quay:SampleCoverage
                 quay:IncrementalCoverage).

# === Cardinality: AccessDescription ===

# Exactly 1 protocol per AccessDescription
quay:AccessDescription rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty quay:protocol;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
    owl:onClass quay:Protocol
].

# At least 1 authentication scheme
quay:AccessDescription rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty quay:authenticationScheme;
    owl:someValuesFrom quay:AuthenticationScheme
].

# At least 1 supported operation
quay:AccessDescription rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty quay:supportedOperation;
    owl:someValuesFrom quay:Operation
].

# === Cardinality: YieldDescription ===

# Exactly 1 delivery mode
quay:YieldDescription rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty quay:deliveryMode;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
    owl:onClass quay:DeliveryMode
].

# At most 1 temporal quality
quay:YieldDescription rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty quay:temporalQuality;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
    owl:onClass quay:TemporalQuality
].

# At most 1 coverage
quay:YieldDescription rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty quay:coverage;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
    owl:onClass quay:Coverage
].
