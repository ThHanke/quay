@prefix : <https://w3id.org/quay/quay-full.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/quay/quay-full.owl#> .

<https://w3id.org/quay/quay-full.owl> rdf:type owl:Ontology ;
                                       owl:versionIRI <https://w3id.org/quay/releases/2026-08-17/quay-full.owl> ;
                                       <http://purl.org/dc/terms/description> "A DCAT Profile for Data Access, Storage and Authorization Metadata." ;
                                       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                       <http://purl.org/dc/terms/title> "QUAY: Qualified Usage, Access and Yield" ;
                                       owl:versionInfo "2026-08-17" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/source
<http://purl.org/dc/elements/1.1/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/pav/hasVersion
<http://purl.org/pav/hasVersion> rdf:type owl:ObjectProperty ;
                                 owl:equivalentProperty <http://www.w3.org/ns/dcat#hasVersion> .


###  http://www.w3.org/ns/dcat#accessService
<http://www.w3.org/ns/dcat#accessService> rdf:type owl:ObjectProperty ;
                                          rdfs:range <http://www.w3.org/ns/dcat#DataService> ;
                                          rdfs:label "data access service"@en ,
                                                     "dataadgangstjeneste"@da ,
                                                     "servicio de acceso de datos"@es ,
                                                     "servizio di accesso ai dati"@it ,
                                                     "služba pro přístup k datům"@cs .


###  http://www.w3.org/ns/dcat#accessURL
<http://www.w3.org/ns/dcat#accessURL> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://www.w3.org/ns/dcat#Distribution> ;
                                      rdfs:range rdfs:Resource ;
                                      owl:propertyChainAxiom ( <http://www.w3.org/ns/dcat#accessService>
                                                               <http://www.w3.org/ns/dcat#endpointURL>
                                                             ) ;
                                      rdfs:label "URL d'accès"@fr ,
                                                 "URL de acceso"@es ,
                                                 "URL πρόσβασης"@el ,
                                                 "access address"@en ,
                                                 "adgangsadresse"@da ,
                                                 "indirizzo di accesso"@it ,
                                                 "přístupová adresa"@cs ,
                                                 "رابط وصول"@ar ,
                                                 "アクセスURL"@ja .


###  http://www.w3.org/ns/dcat#catalog
<http://www.w3.org/ns/dcat#catalog> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <http://www.w3.org/ns/dcat#resource> ;
                                    rdfs:domain <http://www.w3.org/ns/dcat#Catalog> ;
                                    rdfs:range <http://www.w3.org/ns/dcat#Catalog> ;
                                    rdfs:label "catalog"@en ,
                                               "catalogo"@it ,
                                               "catálogo"@es ,
                                               "katalog"@cs ,
                                               "katalog"@da .


###  http://www.w3.org/ns/dcat#compressFormat
<http://www.w3.org/ns/dcat#compressFormat> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://www.w3.org/ns/dcat#Distribution> ;
                                           rdfs:range <http://purl.org/dc/terms/MediaType> ;
                                           rdfs:label "compression format"@en ,
                                                      "formato de compresión"@es ,
                                                      "formato di compressione"@it ,
                                                      "formát komprese"@cs ,
                                                      "kompressionsformat"@da .


###  http://www.w3.org/ns/dcat#contactPoint
<http://www.w3.org/ns/dcat#contactPoint> rdf:type owl:ObjectProperty ;
                                         rdfs:range <http://www.w3.org/2006/vcard/ns#Kind> ;
                                         rdfs:label "Punto de contacto"@es ,
                                                    "contact point"@en ,
                                                    "kontaktní bod"@cs ,
                                                    "kontaktpunkt"@da ,
                                                    "point de contact"@fr ,
                                                    "punto di contatto"@it ,
                                                    "σημείο επικοινωνίας"@el ,
                                                    "عنوان اتصال"@ar ,
                                                    "窓口"@ja .


###  http://www.w3.org/ns/dcat#dataset
<http://www.w3.org/ns/dcat#dataset> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <http://www.w3.org/ns/dcat#resource> ;
                                    rdfs:domain <http://www.w3.org/ns/dcat#Catalog> ;
                                    rdfs:range <http://www.w3.org/ns/dcat#Dataset> ;
                                    rdfs:label "conjunto de datos"@es ,
                                               "dataset"@en ,
                                               "dataset"@it ,
                                               "datasæt"@da ,
                                               "datová sada"@cs ,
                                               "jeu de données"@fr ,
                                               "σύνολο δεδομένων"@el ,
                                               "قائمة بيانات"@ar ,
                                               "データセット"@ja .


###  http://www.w3.org/ns/dcat#distribution
<http://www.w3.org/ns/dcat#distribution> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <http://www.w3.org/ns/dcat#isDistributionOf> ;
                                         rdfs:domain <http://www.w3.org/ns/dcat#Dataset> ;
                                         rdfs:range <http://www.w3.org/ns/dcat#Distribution> ;
                                         rdfs:label "distribuce"@cs ,
                                                    "distribución"@es ,
                                                    "distribution"@da ,
                                                    "distribution"@en ,
                                                    "distribution"@fr ,
                                                    "distribuzione"@it ,
                                                    "διανομή"@el ,
                                                    "توزيع"@ar ,
                                                    "データセット配信"@ja .


###  http://www.w3.org/ns/dcat#downloadURL
<http://www.w3.org/ns/dcat#downloadURL> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://www.w3.org/ns/dcat#Distribution> ;
                                        rdfs:range rdfs:Resource ;
                                        rdfs:label "URL de descarga"@es ,
                                                   "URL de téléchargement"@fr ,
                                                   "URL di scarico"@it ,
                                                   "URL souboru ke stažení"@cs ,
                                                   "URL μεταφόρτωσης"@el ,
                                                   "download URL"@en ,
                                                   "downloadURL"@da ,
                                                   "رابط تحميل"@ar ,
                                                   "ダウンロードURL"@ja .


###  http://www.w3.org/ns/dcat#endpointDescription
<http://www.w3.org/ns/dcat#endpointDescription> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://www.w3.org/ns/dcat#DataService> ;
                                                rdfs:label "descripción del end-point del servicio"@es ,
                                                           "description of service end-point"@en ,
                                                           "descrizione dell'endpoint del servizio"@it ,
                                                           "endpointbeskrivelse"@da ,
                                                           "popis přístupového bodu služby"@cs .


###  http://www.w3.org/ns/dcat#endpointURL
<http://www.w3.org/ns/dcat#endpointURL> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://www.w3.org/ns/dcat#DataService> ;
                                        rdfs:range rdfs:Resource ;
                                        rdfs:label "end-point del servicio"@es ,
                                                   "end-point del servizio"@it ,
                                                   "přístupový bod služby"@cs ,
                                                   "service end-point"@en ,
                                                   "tjenesteendpoint"@da .


###  http://www.w3.org/ns/dcat#hasCurrentVersion
<http://www.w3.org/ns/dcat#hasCurrentVersion> rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf <http://purl.org/pav/hasVersion> ;
                                              rdfs:label "ha versione attuale"@it ,
                                                         "has current version"@en ,
                                                         "tiene versión actual"@es .


###  http://www.w3.org/ns/dcat#hasVersion
<http://www.w3.org/ns/dcat#hasVersion> rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf <http://www.w3.org/ns/prov#generalizationOf> ;
                                       owl:inverseOf <http://www.w3.org/ns/dcat#isVersionOf> ;
                                       rdfs:label "ha versione"@it ,
                                                  "has version"@en ,
                                                  "tiene versión"@es .


###  http://www.w3.org/ns/dcat#inCatalog
<http://www.w3.org/ns/dcat#inCatalog> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <http://www.w3.org/ns/dcat#resource> .


###  http://www.w3.org/ns/dcat#inSeries
<http://www.w3.org/ns/dcat#inSeries> rdf:type owl:ObjectProperty ;
                                     owl:inverseOf <http://www.w3.org/ns/dcat#seriesMember> ;
                                     rdfs:label "en serie"@es ,
                                                "in serie"@it ,
                                                "in series"@en .


###  http://www.w3.org/ns/dcat#isDistributionOf
<http://www.w3.org/ns/dcat#isDistributionOf> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#isVersionOf
<http://www.w3.org/ns/dcat#isVersionOf> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#mediaType
<http://www.w3.org/ns/dcat#mediaType> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://www.w3.org/ns/dcat#Distribution> ;
                                      rdfs:range <http://purl.org/dc/terms/MediaType> ;
                                      rdfs:label "media type"@en ,
                                                 "medietype"@da ,
                                                 "tipo de media"@es ,
                                                 "tipo di media"@it ,
                                                 "typ média"@cs ,
                                                 "type de média"@fr ,
                                                 "τύπος μέσου"@el ,
                                                 "نوع الميديا"@ar ,
                                                 "メディア・タイプ"@ja .


###  http://www.w3.org/ns/dcat#nextVersion
<http://www.w3.org/ns/dcat#nextVersion> rdf:type owl:ObjectProperty ;
                                        owl:inverseOf <http://www.w3.org/ns/dcat#previousVersion> .


###  http://www.w3.org/ns/dcat#packageFormat
<http://www.w3.org/ns/dcat#packageFormat> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://www.w3.org/ns/dcat#Distribution> ;
                                          rdfs:range <http://purl.org/dc/terms/MediaType> ;
                                          rdfs:label "formato de empaquetado"@es ,
                                                     "formato di impacchettamento"@it ,
                                                     "formát balíčku"@cs ,
                                                     "packaging format"@en ,
                                                     "pakkeformat"@da .


###  http://www.w3.org/ns/dcat#previousVersion
<http://www.w3.org/ns/dcat#previousVersion> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasRevisionOf> ;
                                            rdfs:label "previous version"@en ,
                                                       "versione precedente"@it ,
                                                       "versión anterior"@es .


###  http://www.w3.org/ns/dcat#resource
<http://www.w3.org/ns/dcat#resource> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://www.w3.org/ns/dcat#Catalog> ;
                                     rdfs:range <http://www.w3.org/ns/dcat#Resource> ;
                                     rdfs:label "resource"@en ,
                                                "risorsa"@it .


###  http://www.w3.org/ns/dcat#seriesMember
<http://www.w3.org/ns/dcat#seriesMember> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#servesDataset
<http://www.w3.org/ns/dcat#servesDataset> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://www.w3.org/ns/dcat#DataService> ;
                                          rdfs:range <http://www.w3.org/ns/dcat#Dataset> ;
                                          rdfs:label "datatjeneste for datasæt"@da ,
                                                     "poskytuje datovou sadu"@cs ,
                                                     "provee conjunto de datos"@es ,
                                                     "serve set di dati"@it ,
                                                     "serves dataset"@en .


###  http://www.w3.org/ns/dcat#service
<http://www.w3.org/ns/dcat#service> rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <http://www.w3.org/ns/dcat#resource> ;
                                    rdfs:domain <http://www.w3.org/ns/dcat#Catalog> ;
                                    rdfs:range <http://www.w3.org/ns/dcat#DataService> ;
                                    rdfs:label "datatjeneste"@da ,
                                               "service"@en ,
                                               "servicio"@es ,
                                               "servizio"@it ,
                                               "služba"@cs .


###  http://www.w3.org/ns/dcat#theme
<http://www.w3.org/ns/dcat#theme> rdf:type owl:ObjectProperty ;
                                  rdfs:label "emne"@da ,
                                             "tema"@es ,
                                             "tema"@it ,
                                             "theme"@en ,
                                             "thème"@fr ,
                                             "téma"@cs ,
                                             "Θέμα"@el ,
                                             "التصنيف"@ar ,
                                             "テーマ/カテゴリー"@ja .


###  http://www.w3.org/ns/odrl/2/action
<http://www.w3.org/ns/odrl/2/action> rdf:type owl:ObjectProperty ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( <http://www.w3.org/ns/odrl/2/Policy>
                                                                 <http://www.w3.org/ns/odrl/2/Rule>
                                                               )
                                                 ] ;
                                     rdfs:range <http://www.w3.org/ns/odrl/2/Action> .


###  http://www.w3.org/ns/odrl/2/constraint
<http://www.w3.org/ns/odrl/2/constraint> rdf:type owl:ObjectProperty ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( <http://www.w3.org/ns/odrl/2/Policy>
                                                                     <http://www.w3.org/ns/odrl/2/Rule>
                                                                   )
                                                     ] ;
                                         rdfs:range [ rdf:type owl:Class ;
                                                      owl:unionOf ( <http://www.w3.org/ns/odrl/2/Constraint>
                                                                    <http://www.w3.org/ns/odrl/2/LogicalConstraint>
                                                                  )
                                                    ] .


###  http://www.w3.org/ns/odrl/2/duty
<http://www.w3.org/ns/odrl/2/duty> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <http://www.w3.org/ns/odrl/2/Permission> ;
                                   rdfs:range <http://www.w3.org/ns/odrl/2/Duty> .


###  http://www.w3.org/ns/odrl/2/hasPolicy
<http://www.w3.org/ns/odrl/2/hasPolicy> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://www.w3.org/ns/odrl/2/Asset> ;
                                        rdfs:range <http://www.w3.org/ns/odrl/2/Policy> .


###  http://www.w3.org/ns/odrl/2/includedIn
<http://www.w3.org/ns/odrl/2/includedIn> rdf:type owl:ObjectProperty ,
                                                  owl:TransitiveProperty ;
                                         rdfs:domain <http://www.w3.org/ns/odrl/2/Action> ;
                                         rdfs:range <http://www.w3.org/ns/odrl/2/Action> .


###  http://www.w3.org/ns/odrl/2/obligation
<http://www.w3.org/ns/odrl/2/obligation> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://www.w3.org/ns/odrl/2/Policy> ;
