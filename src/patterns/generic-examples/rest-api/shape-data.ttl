@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/rest-api> a owl:Ontology ;
    dcterms:title "QUAY Pattern: REST API" ;
    dcterms:description "ABox example modeling REST API data access as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:rest-api-dataset a dcat:Dataset ;
    dcterms:title "National Air Quality Monitoring Data" .

ex:rest-api-service a dcat:DataService ;
    dcterms:title "Air Quality REST API" ;
    dcat:endpointURL <https://api.airquality.gov/v2/measurements> ;
    dcat:servesDataset ex:rest-api-dataset .

ex:rest-api-distribution a dcat:Distribution ;
    dcterms:title "Paginated JSON API distribution" ;
    dcat:accessService ex:rest-api-service ;
    dcat:mediaType "application/json" ;
    quay:QUAY_0000046 ex:rest-api-access ;
    quay:QUAY_0000047 ex:rest-api-yield ;
    quay:QUAY_0000057 "TLS 1.2" .

ex:rest-api-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000004 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000018 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000026 ] .

ex:rest-api-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000032 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000035 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000041 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000062 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000070 ] .
