@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/sparql-endpoint> a owl:Ontology ;
    dcterms:title "QUAY Pattern: SPARQL Endpoint" ;
    dcterms:description "ABox example modeling SPARQL endpoint as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:sparql-dataset a dcat:Dataset ;
    dcterms:title "DBpedia Knowledge Graph" .

ex:sparql-service a dcat:DataService ;
    dcterms:title "DBpedia SPARQL Endpoint" ;
    dcat:endpointURL <https://dbpedia.org/sparql> ;
    dcat:servesDataset ex:sparql-dataset .

ex:sparql-distribution a dcat:Distribution ;
    dcterms:title "SPARQL query distribution" ;
    dcat:accessService ex:sparql-service ;
    dcat:mediaType "application/sparql-results+json" ;
    quay:accessDescription ex:sparql-access ;
    quay:yieldDescription ex:sparql-yield ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] ;
    dcterms:conformsTo <http://www.w3.org/TR/sparql11-protocol/> .

ex:sparql-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] .

ex:sparql-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:StreamingDelivery ] ;
    quay:temporalQuality [ a quay:RealTime ] ;
    quay:coverage [ a quay:SubsetCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:NoVerification ] .
