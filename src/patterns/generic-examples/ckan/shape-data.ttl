@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

<https://w3id.org/quay/examples/ckan> a owl:Ontology ;
    dcterms:title "QUAY Pattern: CKAN Data Portal" ;
    dcterms:description "ABox example modeling CKAN data portal as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:ckan-dataset a dcat:Dataset ;
    dcterms:title "National Transport Statistics" .

ex:ckan-service a dcat:DataService ;
    dcterms:title "Government Open Data Portal" ;
    dcat:endpointURL <https://data.gov.example/api/3/> ;
    dcat:servesDataset ex:ckan-dataset .

ex:ckan-distribution a dcat:Distribution ;
    dcterms:title "CKAN API distribution" ;
    dcat:accessService ex:ckan-service ;
    dcat:mediaType "application/json" ;
    quay:accessDescription ex:ckan-access ;
    quay:yieldDescription ex:ckan-yield ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] ;
    dcterms:conformsTo <https://docs.ckan.org/en/latest/api/> ;
    odrl:hasPolicy ex:ckan-policy .

ex:ckan-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:ckan-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:PaginatedDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:SubsetCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:NoVerification ] .

ex:ckan-policy a odrl:Set ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action [ a quay:ReadOperation ] ;
        odrl:target ex:ckan-distribution
    ] ;
    odrl:prohibition [
        a odrl:Prohibition ;
        odrl:action [ a quay:WriteOperation ] ;
        odrl:target ex:ckan-distribution
    ] .
