@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/zenodo> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Zenodo Deposit" ;
    dcterms:description "ABox example modeling Zenodo repository deposit as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:zenodo-dataset a dcat:Dataset ;
    dcterms:title "Climate Model Output Dataset" ;
    dcterms:identifier <https://doi.org/10.5281/zenodo.1234567> .

ex:zenodo-distribution a dcat:Distribution ;
    dcterms:title "Zenodo deposit distribution" ;
    dcat:downloadURL <https://zenodo.org/records/1234567/files/climate-data-v2.tar.gz> ;
    dcat:mediaType "application/gzip" ;
    quay:accessDescription ex:zenodo-access ;
    quay:yieldDescription ex:zenodo-yield ;
    quay:encryptionInTransit "TLS 1.2" ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_md5 ] .

ex:zenodo-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:ApiKeyAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:zenodo-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Versioned ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:HighAvailability ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
