@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/postgresql> a owl:Ontology ;
    dcterms:title "QUAY Pattern: PostgreSQL Database" ;
    dcterms:description "ABox example modeling PostgreSQL database access as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:postgresql-dataset a dcat:Dataset ;
    dcterms:title "Clinical Trial Results Database" .

ex:postgresql-service a dcat:DataService ;
    dcterms:title "PostgreSQL Database Server" ;
    dcat:endpointURL <postgresql://db.clinic.example.org:5432/trials> ;
    dcat:servesDataset ex:postgresql-dataset .

ex:postgresql-distribution a dcat:Distribution ;
    dcterms:title "PostgreSQL query distribution" ;
    dcat:accessService ex:postgresql-service ;
    quay:accessDescription ex:postgresql-access ;
    quay:yieldDescription ex:postgresql-yield ;
    quay:encryptionInTransit "TLS 1.2" .

ex:postgresql-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:BasicAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:postgresql-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:SynchronousDelivery ] ;
    quay:temporalQuality [ a quay:RealTime ] ;
    quay:coverage [ a quay:SubsetCoverage ] ;
    quay:serviceQuality [ a quay:HighAvailability ] ;
    quay:verificationMethod [ a quay:NoVerification ] .
