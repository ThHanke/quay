@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/postgresql> a owl:Ontology ;
    dcterms:title "QUAY Pattern: PostgreSQL Database" ;
    dcterms:description "ABox example modeling PostgreSQL database access as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:postgresql-dataset a dcat:Dataset ;
    dcterms:title "Clinical Trial Results Database" .

ex:postgresql-service a dcat:DataService ;
    dcterms:title "PostgreSQL Database Server" ;
    dcat:endpointURL <postgresql://db.clinic.example.org:5432/trials> ;
    dcat:servesDataset ex:postgresql-dataset .

ex:postgresql-distribution a dcat:Distribution ;
    dcterms:title "PostgreSQL query distribution" ;
    dcat:accessService ex:postgresql-service ;
    quay:QUAY_0000046 ex:postgresql-access ;
    quay:QUAY_0000047 ex:postgresql-yield ;
    quay:QUAY_0000057 "TLS 1.2" .

ex:postgresql-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000004 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000019 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000024 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000025 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000026 ] .

ex:postgresql-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000060 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000035 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000041 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000062 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000070 ] .
