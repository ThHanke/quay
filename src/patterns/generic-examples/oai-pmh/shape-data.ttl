@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

<https://w3id.org/quay/examples/oai-pmh> a owl:Ontology ;
    dcterms:title "QUAY Pattern: OAI-PMH Harvesting" ;
    dcterms:description "ABox example modeling OAI-PMH harvesting endpoint as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:oai-dataset a dcat:Dataset ;
    dcterms:title "Institutional Repository Metadata" .

ex:oai-service a dcat:DataService ;
    dcterms:title "OAI-PMH Harvesting Endpoint" ;
    dcat:endpointURL <https://repository.example.edu/oai> ;
    dcat:servesDataset ex:oai-dataset .

ex:oai-distribution a dcat:Distribution ;
    dcterms:title "OAI-PMH harvested distribution" ;
    dcat:accessService ex:oai-service ;
    dcat:mediaType "application/xml" ;
    quay:accessDescription ex:oai-access ;
    quay:yieldDescription ex:oai-yield ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] ;
    dcterms:conformsTo <http://www.openarchives.org/OAI/openarchivesprotocol.html> ;
    odrl:hasPolicy ex:oai-policy .

ex:oai-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:oai-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:PaginatedDelivery ] ;
    quay:temporalQuality [ a quay:Archived ] ;
    quay:coverage [ a quay:IncrementalCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:NoVerification ] .

ex:oai-policy a odrl:Set ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action [ a quay:ReadOperation ] ;
        odrl:target ex:oai-distribution
    ] ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action [ a quay:ListOperation ] ;
        odrl:target ex:oai-distribution
    ] .
