@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/azure-blob> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Azure Blob Storage" ;
    dcterms:description "ABox example modeling Azure Blob Storage as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:azure-dataset a dcat:Dataset ;
    dcterms:title "Enterprise Data Lake on Azure" .

ex:azure-distribution a dcat:Distribution ;
    dcterms:title "Azure Blob Storage distribution" ;
    dcat:accessURL <https://researchdata.blob.core.windows.net/datasets/> ;
    quay:accessDescription ex:azure-access ;
    quay:yieldDescription ex:azure-yield ;
    quay:encryptionAtRest [ a quay:Aes256Encryption ] ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_md5 ] .

ex:azure-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:ApiKeyAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:azure-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:HighAvailability ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
