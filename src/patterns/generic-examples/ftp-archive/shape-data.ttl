@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/ftp-archive> a owl:Ontology ;
    dcterms:title "QUAY Pattern: FTP Archive" ;
    dcterms:description "ABox example modeling FTP archive access as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:ftp-dataset a dcat:Dataset ;
    dcterms:title "University Genomics Archive" .

ex:ftp-distribution a dcat:Distribution ;
    dcterms:title "FTP archive distribution" ;
    dcat:downloadURL <ftp://ftp.genomics.example.edu/pub/sequences/> ;
    quay:accessDescription ex:ftp-access ;
    quay:yieldDescription ex:ftp-yield .

ex:ftp-access a quay:AccessDescription ;
    quay:protocol [ a quay:FtpProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:ftp-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Archived ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:NoVerification ] .
