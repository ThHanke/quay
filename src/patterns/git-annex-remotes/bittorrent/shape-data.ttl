@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/bittorrent> a owl:Ontology ;
    dcterms:title "QUAY Pattern: BitTorrent Special Remote" ;
    dcterms:description "ABox example modeling git-annex BitTorrent special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:bittorrent-dataset a dcat:Dataset ;
    dcterms:title "Open Dataset Distributed via BitTorrent" .

ex:bittorrent-distribution a dcat:Distribution ;
    dcterms:title "BitTorrent swarm distribution" ;
    dcat:accessURL <magnet:?xt=urn:btih:example-hash> ;
    quay:accessDescription ex:bittorrent-access ;
    quay:yieldDescription ex:bittorrent-yield .

ex:bittorrent-access a quay:AccessDescription ;
    quay:protocol [ a quay:BitTorrentProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] .

ex:bittorrent-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:PeerToPeerDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:Distributed ] ;
    quay:verificationMethod [ a quay:PieceVerification ] .
