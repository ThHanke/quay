@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/git-lfs> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Git LFS Special Remote" ;
    dcterms:description "ABox example modeling git-annex Git LFS special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:git-lfs-dataset a dcat:Dataset ;
    dcterms:title "Large Research Files on GitHub LFS" .

ex:git-lfs-distribution a dcat:Distribution ;
    dcterms:title "Git LFS distribution" ;
    dcat:accessURL <https://github.com/org/data-repo.git> ;
    quay:QUAY_0000046 ex:git-lfs-access ;
    quay:QUAY_0000047 ex:git-lfs-yield ;
    quay:QUAY_0000057 "TLS 1.2" ;
    quay:QUAY_0000059 "SHA-256" .

ex:git-lfs-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000004 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000018 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000024 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000025 ] .

ex:git-lfs-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000030 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000038 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000040 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000063 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000066 ] .
