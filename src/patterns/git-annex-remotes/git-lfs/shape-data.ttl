@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/git-lfs> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Git LFS Special Remote" ;
    dcterms:description "ABox example modeling git-annex Git LFS special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:git-lfs-dataset a dcat:Dataset ;
    dcterms:title "Large Research Files on GitHub LFS" .

ex:git-lfs-distribution a dcat:Distribution ;
    dcterms:title "Git LFS distribution" ;
    dcat:accessURL <https://github.com/org/data-repo.git> ;
    quay:accessDescription ex:git-lfs-access ;
    quay:yieldDescription ex:git-lfs-yield ;
    quay:encryptionInTransit "TLS 1.2" ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:git-lfs-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:OAuth2Authentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] .

ex:git-lfs-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Versioned ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
