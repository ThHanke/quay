@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .

ex:ipfs-dataset a dcat:Dataset ;
    dcterms:title "Decentralised Research Data on IPFS" .

ex:ipfs-distribution a dcat:Distribution ;
    dcterms:title "IPFS content-addressed distribution" ;
    dcat:accessURL <ipfs://bafybeigdyrzt5sfp7udm7hu76uh7y26nf3efuylqabf3oclgtqy55fbzdi> ;
    quay:QUAY_0000046 ex:ipfs-access ;
    quay:QUAY_0000047 ex:ipfs-yield .

ex:ipfs-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000010 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000016 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000024 ] .

ex:ipfs-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000061 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000038 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000040 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000065 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000067 ] .
