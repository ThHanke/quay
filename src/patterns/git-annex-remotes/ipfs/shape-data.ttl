@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/ipfs> a owl:Ontology ;
    dcterms:title "QUAY Pattern: IPFS Special Remote" ;
    dcterms:description "ABox example modeling git-annex IPFS special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:ipfs-dataset a dcat:Dataset ;
    dcterms:title "Decentralised Research Data on IPFS" .

ex:ipfs-distribution a dcat:Distribution ;
    dcterms:title "IPFS content-addressed distribution" ;
    dcat:accessURL <ipfs://bafybeigdyrzt5sfp7udm7hu76uh7y26nf3efuylqabf3oclgtqy55fbzdi> ;
    quay:accessDescription ex:ipfs-access ;
    quay:yieldDescription ex:ipfs-yield .

ex:ipfs-access a quay:AccessDescription ;
    quay:protocol [ a quay:IpfsProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] .

ex:ipfs-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:PeerToPeerDelivery ] ;
    quay:temporalQuality [ a quay:Versioned ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:Distributed ] ;
    quay:verificationMethod [ a quay:ContentAddressing ] .
