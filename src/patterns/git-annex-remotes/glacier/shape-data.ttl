@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

<https://w3id.org/quay/examples/glacier> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Glacier Special Remote" ;
    dcterms:description "ABox example modeling git-annex Glacier special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:glacier-dataset a dcat:Dataset ;
    dcterms:title "Long-Term Archive on Glacier" .

ex:glacier-distribution a dcat:Distribution ;
    dcterms:title "Glacier archive distribution" ;
    dcat:accessURL <s3://archive-vault/glacier/> ;
    quay:accessDescription ex:glacier-access ;
    quay:yieldDescription ex:glacier-yield ;
    quay:encryptionAtRest [ a quay:Aes256Encryption ] ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] ;
    quay:retentionPeriod "P99Y"^^xsd:duration ;
    quay:storageJurisdiction <http://publications.europa.eu/resource/authority/country/USA> ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] ;
    odrl:hasPolicy ex:glacier-policy .

ex:glacier-access a quay:AccessDescription ;
    quay:protocol [ a quay:S3Protocol ] ;
    quay:authenticationScheme [ a quay:AwsCredentialAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] .

ex:glacier-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Archived ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:HighAvailability ] ;
    quay:verificationMethod [ a quay:HashVerification ] ;
    quay:uptimePercentage "99.99"^^xsd:decimal ;
    quay:recoveryTimeObjective "PT12H"^^xsd:duration ;
    quay:recoveryPointObjective "PT1H"^^xsd:duration ;
    quay:replicationFactor "3"^^xsd:nonNegativeInteger .

ex:glacier-policy a odrl:Set ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action [ a quay:ReadOperation ] ;
        odrl:target ex:glacier-distribution ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:spatial ;
            odrl:operator odrl:eq ;
            odrl:rightOperand <http://publications.europa.eu/resource/authority/country/USA>
        ]
    ] ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action [ a quay:WriteOperation ] ;
        odrl:target ex:glacier-distribution
    ] ;
    odrl:prohibition [
        a odrl:Prohibition ;
        odrl:action [ a quay:DeleteOperation ] ;
        odrl:target ex:glacier-distribution
    ] .
