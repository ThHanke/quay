@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/glacier> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Glacier Special Remote" ;
    dcterms:description "ABox example modeling git-annex Glacier special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:glacier-dataset a dcat:Dataset ;
    dcterms:title "Long-Term Archive on Glacier" .

ex:glacier-distribution a dcat:Distribution ;
    dcterms:title "Glacier archive distribution" ;
    dcat:accessURL <s3://archive-vault/glacier/> ;
    quay:QUAY_0000046 ex:glacier-access ;
    quay:QUAY_0000047 ex:glacier-yield ;
    quay:QUAY_0000056 "AES-256" ;
    quay:QUAY_0000057 "TLS 1.2" ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:glacier-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000005 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000022 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000024 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000025 ] .

ex:glacier-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000030 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000037 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000040 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000062 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000066 ] .
