@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/rclone> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Rclone Special Remote" ;
    dcterms:description "ABox example modeling git-annex rclone special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:rclone-dataset a dcat:Dataset ;
    dcterms:title "Cloud-Synced Archive via Rclone" .

ex:rclone-distribution a dcat:Distribution ;
    dcterms:title "Rclone remote distribution" ;
    quay:accessDescription ex:rclone-access ;
    quay:yieldDescription ex:rclone-yield ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:rclone-access a quay:AccessDescription ;
    quay:protocol [ a quay:RcloneProtocol ] ;
    quay:authenticationScheme [ a quay:ApiKeyAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] .

ex:rclone-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
