@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/webdav> a owl:Ontology ;
    dcterms:title "QUAY Pattern: WebDAV Special Remote" ;
    dcterms:description "ABox example modeling git-annex WebDAV special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:webdav-dataset a dcat:Dataset ;
    dcterms:title "Shared Files on WebDAV Server" .

ex:webdav-distribution a dcat:Distribution ;
    dcterms:title "WebDAV distribution" ;
    dcat:accessURL <https://webdav.example.com/annex/> ;
    quay:accessDescription ex:webdav-access ;
    quay:yieldDescription ex:webdav-yield ;
    quay:encryptionInTransit "TLS 1.2" ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:webdav-access a quay:AccessDescription ;
    quay:protocol [ a quay:WebDavProtocol ] ;
    quay:authenticationScheme [ a quay:BasicAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] .

ex:webdav-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
