@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/gcrypt> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Gcrypt Core Remote" ;
    dcterms:description "ABox example modeling git-annex gcrypt core remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:gcrypt-dataset a dcat:Dataset ;
    dcterms:title "Encrypted Repository on Untrusted Host" .

ex:gcrypt-distribution a dcat:Distribution ;
    dcterms:title "Gcrypt encrypted distribution" ;
    dcat:accessURL <gcrypt::ssh://storage@untrusted-host.example.org/srv/encrypted-repo> ;
    quay:accessDescription ex:gcrypt-access ;
    quay:yieldDescription ex:gcrypt-yield ;
    quay:encryptionAtRest "GPG" ;
    quay:encryptionInTransit "SSH" ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:gcrypt-access a quay:AccessDescription ;
    quay:protocol [ a quay:GitProtocol ] ;
    quay:authenticationScheme [ a quay:GpgKeyAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] ;
    quay:supportedOperation [ a quay:ReplicateOperation ] .

ex:gcrypt-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Versioned ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:DigitalSignature ] .
