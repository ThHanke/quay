@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/web> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Web Special Remote" ;
    dcterms:description "ABox example modeling git-annex web special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:web-dataset a dcat:Dataset ;
    dcterms:title "Public Dataset from Web URLs" .

ex:web-distribution a dcat:Distribution ;
    dcterms:title "Web URL distribution" ;
    dcat:downloadURL <https://example.org/data/archive.tar.gz> ;
    quay:QUAY_0000046 ex:web-access ;
    quay:QUAY_0000047 ex:web-yield ;
    quay:QUAY_0000057 "TLS 1.2" .

ex:web-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000004 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000016 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] .

ex:web-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000030 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000036 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000040 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000063 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000070 ] .
