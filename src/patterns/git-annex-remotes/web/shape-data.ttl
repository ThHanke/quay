@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/web> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Web Special Remote" ;
    dcterms:description "ABox example modeling git-annex web special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:web-dataset a dcat:Dataset ;
    dcterms:title "Public Dataset from Web URLs" .

ex:web-distribution a dcat:Distribution ;
    dcterms:title "Web URL distribution" ;
    dcat:downloadURL <https://example.org/data/archive.tar.gz> ;
    quay:accessDescription ex:web-access ;
    quay:yieldDescription ex:web-yield ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] .

ex:web-access a quay:AccessDescription ;
    quay:protocol [ a quay:HttpProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] .

ex:web-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:NoVerification ] .
