@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/borg> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Borg Special Remote" ;
    dcterms:description "ABox example modeling git-annex Borg special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:borg-dataset a dcat:Dataset ;
    dcterms:title "Deduplicated Backup via Borg" .

ex:borg-distribution a dcat:Distribution ;
    dcterms:title "Borg repository distribution" ;
    dcat:accessURL <ssh://backup@borg-host.example.org/srv/borg/annex> ;
    quay:QUAY_0000046 ex:borg-access ;
    quay:QUAY_0000047 ex:borg-yield ;
    quay:QUAY_0000056 "AES-256-CTR" ;
    quay:QUAY_0000057 "SSH" ;
    quay:QUAY_0000059 "SHA-256" .

ex:borg-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000008 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000020 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000024 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000025 ] .

ex:borg-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000030 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000038 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000040 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000064 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000066 ] .
