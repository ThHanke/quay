@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/borg> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Borg Special Remote" ;
    dcterms:description "ABox example modeling git-annex Borg special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:borg-dataset a dcat:Dataset ;
    dcterms:title "Deduplicated Backup via Borg" .

ex:borg-distribution a dcat:Distribution ;
    dcterms:title "Borg repository distribution" ;
    dcat:accessURL <ssh://backup@borg-host.example.org/srv/borg/annex> ;
    quay:accessDescription ex:borg-access ;
    quay:yieldDescription ex:borg-yield ;
    quay:encryptionAtRest "AES-256-CTR" ;
    quay:encryptionInTransit "SSH" ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:borg-access a quay:AccessDescription ;
    quay:protocol [ a quay:SshProtocol ] ;
    quay:authenticationScheme [ a quay:SshKeyAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] .

ex:borg-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Versioned ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:SingleHost ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
