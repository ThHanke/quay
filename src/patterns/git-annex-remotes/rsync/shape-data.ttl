@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/rsync> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Rsync Special Remote" ;
    dcterms:description "ABox example modeling git-annex rsync special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:rsync-dataset a dcat:Dataset ;
    dcterms:title "Backup Archive via Rsync" .

ex:rsync-distribution a dcat:Distribution ;
    dcterms:title "Rsync remote distribution" ;
    dcat:accessURL <rsync://backup-host.example.org/annex/> ;
    quay:accessDescription ex:rsync-access ;
    quay:yieldDescription ex:rsync-yield ;
    quay:encryptionInTransit [ a quay:SshEncryption ] ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:rsync-access a quay:AccessDescription ;
    quay:protocol [ a quay:RsyncProtocol ] ;
    quay:authenticationScheme [ a quay:SshKeyAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] .

ex:rsync-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:BestEffort ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
