@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/directory> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Directory Special Remote" ;
    dcterms:description "ABox example modeling git-annex directory special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:directory-dataset a dcat:Dataset ;
    dcterms:title "Local Backup on External Drive" .

ex:directory-distribution a dcat:Distribution ;
    dcterms:title "Directory remote distribution" ;
    dcat:accessURL <file:///mnt/backup/annex/> ;
    quay:accessDescription ex:directory-access ;
    quay:yieldDescription ex:directory-yield ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:directory-access a quay:AccessDescription ;
    quay:protocol [ a quay:LocalFilesystemProtocol ] ;
    quay:authenticationScheme [ a quay:NoAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:directory-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:SingleHost ] ;
    quay:verificationMethod [ a quay:HashVerification ] .
