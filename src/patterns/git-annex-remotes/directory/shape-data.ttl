@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/quay/examples/directory> a owl:Ontology ;
    dcterms:title "QUAY Pattern: Directory Special Remote" ;
    dcterms:description "ABox example modeling git-annex directory special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:directory-dataset a dcat:Dataset ;
    dcterms:title "Local Backup on External Drive" .

ex:directory-distribution a dcat:Distribution ;
    dcterms:title "Directory remote distribution" ;
    dcat:accessURL <file:///mnt/backup/annex/> ;
    quay:QUAY_0000046 ex:directory-access ;
    quay:QUAY_0000047 ex:directory-yield ;
    quay:QUAY_0000059 "SHA-256" .

ex:directory-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000011 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000016 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000024 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000025 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000026 ] .

ex:directory-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000030 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000036 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000040 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000064 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000066 ] .
