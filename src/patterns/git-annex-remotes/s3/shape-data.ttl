@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

<https://w3id.org/quay/examples/s3> a owl:Ontology ;
    dcterms:title "QUAY Pattern: S3 Special Remote" ;
    dcterms:description "ABox example modeling git-annex S3 special remote as DCAT distribution with QUAY access and yield descriptions." ;
    owl:imports <https://w3id.org/quay/> .

ex:s3-dataset a dcat:Dataset ;
    dcterms:title "Research Data Archive on S3" .

ex:s3-distribution a dcat:Distribution ;
    dcterms:title "S3 bucket distribution" ;
    dcat:accessURL <s3://research-data-bucket/> ;
    quay:accessDescription ex:s3-access ;
    quay:yieldDescription ex:s3-yield ;
    quay:encryptionAtRest [ a quay:Aes256Encryption ] ;
    quay:encryptionInTransit [ a quay:Tls12Encryption ] ;
    quay:retentionPeriod "P5Y"^^xsd:duration ;
    spdx:checksum [ a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ] .

ex:s3-access a quay:AccessDescription ;
    quay:protocol [ a quay:S3Protocol ] ;
    quay:authenticationScheme [ a quay:AwsCredentialAuthentication ] ;
    quay:supportedOperation [ a quay:ReadOperation ] ;
    quay:supportedOperation [ a quay:WriteOperation ] ;
    quay:supportedOperation [ a quay:DeleteOperation ] ;
    quay:supportedOperation [ a quay:ListOperation ] .

ex:s3-yield a quay:YieldDescription ;
    quay:deliveryMode [ a quay:BulkDelivery ] ;
    quay:temporalQuality [ a quay:Snapshot ] ;
    quay:coverage [ a quay:CompleteCoverage ] ;
    quay:serviceQuality [ a quay:HighAvailability ] ;
    quay:verificationMethod [ a quay:HashVerification ] ;
    quay:uptimePercentage "99.95"^^xsd:decimal ;
    quay:replicationFactor "3"^^xsd:nonNegativeInteger .
