@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://w3id.org/quay/examples/> .

ex:s3-dataset a dcat:Dataset ;
    dcterms:title "Research Data Archive on S3" .

ex:s3-distribution a dcat:Distribution ;
    dcterms:title "S3 bucket distribution" ;
    dcat:accessURL <s3://research-data-bucket/> ;
    quay:QUAY_0000046 ex:s3-access ;
    quay:QUAY_0000047 ex:s3-yield ;
    quay:QUAY_0000056 "AES-256" ;
    quay:QUAY_0000057 "TLS 1.2" ;
    quay:QUAY_0000059 "SHA-256" .

ex:s3-access a quay:QUAY_0000001 ;
    quay:QUAY_0000048 [ a quay:QUAY_0000005 ] ;
    quay:QUAY_0000049 [ a quay:QUAY_0000022 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000023 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000024 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000025 ] ;
    quay:QUAY_0000050 [ a quay:QUAY_0000026 ] .

ex:s3-yield a quay:QUAY_0000002 ;
    quay:QUAY_0000051 [ a quay:QUAY_0000030 ] ;
    quay:QUAY_0000052 [ a quay:QUAY_0000036 ] ;
    quay:QUAY_0000053 [ a quay:QUAY_0000040 ] ;
    quay:QUAY_0000054 [ a quay:QUAY_0000062 ] ;
    quay:QUAY_0000055 [ a quay:QUAY_0000066 ] .
