@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix quay: <https://w3id.org/quay/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================
# QUAY SHACL Shapes
# Validates ABox data against QUAY structural constraints.
# Mirrors OWL restriction axioms from quay-edit.owl.
# =============================================

# --- Distribution Shape ---

quay:DistributionShape a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [
        sh:path quay:accessDescription ;
        sh:minCount 1 ;
        sh:name "access description" ;
        sh:message "Distribution must have at least one access description."
    ] ;
    sh:property [
        sh:path quay:yieldDescription ;
        sh:minCount 1 ;
        sh:name "yield description" ;
        sh:message "Distribution must have at least one yield description."
    ] ;
    sh:property [
        sh:path quay:encryptionAtRest ;
        sh:class quay:EncryptionAlgorithm ;
        sh:name "encryption at rest" ;
        sh:message "encryptionAtRest must reference an EncryptionAlgorithm."
    ] ;
    sh:property [
        sh:path quay:encryptionInTransit ;
        sh:class quay:EncryptionAlgorithm ;
        sh:name "encryption in transit" ;
        sh:message "encryptionInTransit must reference an EncryptionAlgorithm."
    ] ;
    sh:property [
        sh:path quay:retentionPeriod ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
        sh:name "retention period" ;
        sh:message "retentionPeriod must be an xsd:duration."
    ] .

# --- AccessDescription Shape ---
# OWL: exactly 1 protocol, >=1 authScheme, >=1 operation

quay:AccessDescriptionShape a sh:NodeShape ;
    sh:targetClass quay:AccessDescription ;
    sh:property [
        sh:path quay:protocol ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "protocol" ;
        sh:message "AccessDescription must have exactly one protocol."
    ] ;
    sh:property [
        sh:path quay:authenticationScheme ;
        sh:minCount 1 ;
        sh:name "authentication scheme" ;
        sh:message "AccessDescription must have at least one authentication scheme."
    ] ;
    sh:property [
        sh:path quay:supportedOperation ;
        sh:minCount 1 ;
        sh:name "supported operation" ;
        sh:message "AccessDescription must have at least one supported operation."
    ] .

# --- YieldDescription Shape ---
# OWL: exactly 1 deliveryMode, <=1 temporalQuality, <=1 coverage,
#       <=1 serviceQuality, <=1 verificationMethod

quay:YieldDescriptionShape a sh:NodeShape ;
    sh:targetClass quay:YieldDescription ;
    sh:property [
        sh:path quay:deliveryMode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "delivery mode" ;
        sh:message "YieldDescription must have exactly one delivery mode."
    ] ;
    sh:property [
        sh:path quay:temporalQuality ;
        sh:maxCount 1 ;
        sh:name "temporal quality" ;
        sh:message "YieldDescription must have at most one temporal quality."
    ] ;
    sh:property [
        sh:path quay:coverage ;
        sh:maxCount 1 ;
        sh:name "coverage" ;
        sh:message "YieldDescription must have at most one coverage."
    ] ;
    sh:property [
        sh:path quay:serviceQuality ;
        sh:maxCount 1 ;
        sh:name "service quality" ;
        sh:message "YieldDescription must have at most one service quality."
    ] ;
    sh:property [
        sh:path quay:verificationMethod ;
        sh:maxCount 1 ;
        sh:name "verification method" ;
        sh:message "YieldDescription must have at most one verification method."
    ] ;
    sh:property [
        sh:path quay:uptimePercentage ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:name "uptime percentage" ;
        sh:message "uptimePercentage must be an xsd:decimal."
    ] ;
    sh:property [
        sh:path quay:recoveryTimeObjective ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
        sh:name "recovery time objective" ;
        sh:message "recoveryTimeObjective must be an xsd:duration."
    ] ;
    sh:property [
        sh:path quay:recoveryPointObjective ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
        sh:name "recovery point objective" ;
        sh:message "recoveryPointObjective must be an xsd:duration."
    ] ;
    sh:property [
        sh:path quay:replicationFactor ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "replication factor" ;
        sh:message "replicationFactor must be an xsd:nonNegativeInteger."
    ] .

# --- AccessDescription extended constraints ---
# Rate limit, quota, and cost properties

quay:AccessDescriptionExtendedShape a sh:NodeShape ;
    sh:targetClass quay:AccessDescription ;
    sh:property [
        sh:path quay:rateLimit ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "rate limit" ;
        sh:message "rateLimit must be an xsd:nonNegativeInteger."
    ] ;
    sh:property [
        sh:path quay:quotaLimit ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "quota limit" ;
        sh:message "quotaLimit must be an xsd:string."
    ] ;
    sh:property [
        sh:path quay:costDescription ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "cost description" ;
        sh:message "costDescription must be an xsd:string."
    ] .
