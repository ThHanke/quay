@prefix : <https://w3id.org/quay.ttl#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dce: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfa: <http://www.w3.org/ns/rdfa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@base <https://w3id.org/quay.ttl> .

<https://w3id.org/quay.ttl> rdf:type owl:Ontology ;
                             owl:versionIRI <https://w3id.org/quay/releases/2026-08-17/quay.ttl> ;
                             dcterms:description """A DCAT Profile for Data Access, Storage and Authorization Metadata.
""" ;
                             dcterms:license <https://w3id.org/quay.owl#CC-BY-4.0> ;
                             dcterms:title "QUAY: Qualified Usage, Access and Yield" ;
                             owl:versionInfo "2026-08-17" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/source
dce:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/pav/hasVersion
<http://purl.org/pav/hasVersion> rdf:type owl:ObjectProperty ;
                                 owl:equivalentProperty dcat:hasVersion .


###  http://www.w3.org/ns/dcat#accessService
dcat:accessService rdf:type owl:ObjectProperty ;
                   rdfs:range dcat:DataService ;
                   rdfs:label "data access service"@en ,
                              "dataadgangstjeneste"@da ,
                              "servicio de acceso de datos"@es ,
                              "servizio di accesso ai dati"@it ,
                              "služba pro přístup k datům"@cs .


###  http://www.w3.org/ns/dcat#accessURL
dcat:accessURL rdf:type owl:ObjectProperty ;
               rdfs:domain dcat:Distribution ;
               rdfs:range rdfs:Resource ;
               owl:propertyChainAxiom ( dcat:accessService
                                        dcat:endpointURL
                                      ) ;
               rdfs:label "URL d'accès"@fr ,
                          "URL de acceso"@es ,
                          "URL πρόσβασης"@el ,
                          "access address"@en ,
                          "adgangsadresse"@da ,
                          "indirizzo di accesso"@it ,
                          "přístupová adresa"@cs ,
                          "رابط وصول"@ar ,
                          "アクセスURL"@ja .


###  http://www.w3.org/ns/dcat#catalog
dcat:catalog rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcat:resource ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:Catalog ;
             rdfs:label "catalog"@en ,
                        "catalogo"@it ,
                        "catálogo"@es ,
                        "katalog"@cs ,
                        "katalog"@da .


###  http://www.w3.org/ns/dcat#compressFormat
dcat:compressFormat rdf:type owl:ObjectProperty ;
                    rdfs:domain dcat:Distribution ;
                    rdfs:range dcterms:MediaType ;
                    rdfs:label "compression format"@en ,
                               "formato de compresión"@es ,
                               "formato di compressione"@it ,
                               "formát komprese"@cs ,
                               "kompressionsformat"@da .


###  http://www.w3.org/ns/dcat#contactPoint
dcat:contactPoint rdf:type owl:ObjectProperty ;
                  rdfs:range <http://www.w3.org/2006/vcard/ns#Kind> ;
                  rdfs:label "Punto de contacto"@es ,
                             "contact point"@en ,
                             "kontaktní bod"@cs ,
                             "kontaktpunkt"@da ,
                             "point de contact"@fr ,
                             "punto di contatto"@it ,
                             "σημείο επικοινωνίας"@el ,
                             "عنوان اتصال"@ar ,
                             "窓口"@ja .


###  http://www.w3.org/ns/dcat#dataset
dcat:dataset rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcat:resource ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:Dataset ;
             rdfs:label "conjunto de datos"@es ,
                        "dataset"@en ,
                        "dataset"@it ,
                        "datasæt"@da ,
                        "datová sada"@cs ,
                        "jeu de données"@fr ,
                        "σύνολο δεδομένων"@el ,
                        "قائمة بيانات"@ar ,
                        "データセット"@ja .


###  http://www.w3.org/ns/dcat#distribution
dcat:distribution rdf:type owl:ObjectProperty ;
                  owl:inverseOf dcat:isDistributionOf ;
                  rdfs:domain dcat:Dataset ;
                  rdfs:range dcat:Distribution ;
                  rdfs:label "distribuce"@cs ,
                             "distribución"@es ,
                             "distribution"@da ,
                             "distribution"@en ,
                             "distribution"@fr ,
                             "distribuzione"@it ,
                             "διανομή"@el ,
                             "توزيع"@ar ,
                             "データセット配信"@ja .


###  http://www.w3.org/ns/dcat#downloadURL
dcat:downloadURL rdf:type owl:ObjectProperty ;
                 rdfs:domain dcat:Distribution ;
                 rdfs:range rdfs:Resource ;
                 rdfs:label "URL de descarga"@es ,
                            "URL de téléchargement"@fr ,
                            "URL di scarico"@it ,
                            "URL souboru ke stažení"@cs ,
                            "URL μεταφόρτωσης"@el ,
                            "download URL"@en ,
                            "downloadURL"@da ,
                            "رابط تحميل"@ar ,
                            "ダウンロードURL"@ja .


###  http://www.w3.org/ns/dcat#endpointDescription
dcat:endpointDescription rdf:type owl:ObjectProperty ;
                         rdfs:domain dcat:DataService ;
                         rdfs:label "descripción del end-point del servicio"@es ,
                                    "description of service end-point"@en ,
                                    "descrizione dell'endpoint del servizio"@it ,
                                    "endpointbeskrivelse"@da ,
                                    "popis přístupového bodu služby"@cs .


###  http://www.w3.org/ns/dcat#endpointURL
dcat:endpointURL rdf:type owl:ObjectProperty ;
                 rdfs:domain dcat:DataService ;
                 rdfs:range rdfs:Resource ;
                 rdfs:label "end-point del servicio"@es ,
                            "end-point del servizio"@it ,
                            "přístupový bod služby"@cs ,
                            "service end-point"@en ,
                            "tjenesteendpoint"@da .


###  http://www.w3.org/ns/dcat#hasCurrentVersion
dcat:hasCurrentVersion rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.org/pav/hasVersion> ;
                       rdfs:label "ha versione attuale"@it ,
                                  "has current version"@en ,
                                  "tiene versión actual"@es .


###  http://www.w3.org/ns/dcat#hasVersion
dcat:hasVersion rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf prov:generalizationOf ;
                owl:inverseOf dcat:isVersionOf ;
                rdfs:label "ha versione"@it ,
                           "has version"@en ,
                           "tiene versión"@es .


###  http://www.w3.org/ns/dcat#inCatalog
dcat:inCatalog rdf:type owl:ObjectProperty ;
               owl:inverseOf dcat:resource .


###  http://www.w3.org/ns/dcat#inSeries
dcat:inSeries rdf:type owl:ObjectProperty ;
              owl:inverseOf dcat:seriesMember ;
              rdfs:label "en serie"@es ,
                         "in serie"@it ,
                         "in series"@en .


###  http://www.w3.org/ns/dcat#isDistributionOf
dcat:isDistributionOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#isVersionOf
dcat:isVersionOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#mediaType
dcat:mediaType rdf:type owl:ObjectProperty ;
               rdfs:domain dcat:Distribution ;
               rdfs:range dcterms:MediaType ;
               rdfs:label "media type"@en ,
                          "medietype"@da ,
                          "tipo de media"@es ,
                          "tipo di media"@it ,
                          "typ média"@cs ,
                          "type de média"@fr ,
                          "τύπος μέσου"@el ,
                          "نوع الميديا"@ar ,
                          "メディア・タイプ"@ja .


###  http://www.w3.org/ns/dcat#nextVersion
dcat:nextVersion rdf:type owl:ObjectProperty ;
                 owl:inverseOf dcat:previousVersion .


###  http://www.w3.org/ns/dcat#packageFormat
dcat:packageFormat rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:Distribution ;
                   rdfs:range dcterms:MediaType ;
                   rdfs:label "formato de empaquetado"@es ,
                              "formato di impacchettamento"@it ,
                              "formát balíčku"@cs ,
                              "packaging format"@en ,
                              "pakkeformat"@da .


###  http://www.w3.org/ns/dcat#previousVersion
dcat:previousVersion rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf prov:wasRevisionOf ;
                     rdfs:label "previous version"@en ,
                                "versione precedente"@it ,
                                "versión anterior"@es .


###  http://www.w3.org/ns/dcat#resource
dcat:resource rdf:type owl:ObjectProperty ;
              rdfs:domain dcat:Catalog ;
              rdfs:range dcat:Resource ;
              rdfs:label "resource"@en ,
                         "risorsa"@it .


###  http://www.w3.org/ns/dcat#seriesMember
dcat:seriesMember rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#servesDataset
dcat:servesDataset rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:DataService ;
                   rdfs:range dcat:Dataset ;
                   rdfs:label "datatjeneste for datasæt"@da ,
                              "poskytuje datovou sadu"@cs ,
                              "provee conjunto de datos"@es ,
                              "serve set di dati"@it ,
                              "serves dataset"@en .


###  http://www.w3.org/ns/dcat#service
dcat:service rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcat:resource ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:DataService ;
             rdfs:label "datatjeneste"@da ,
                        "service"@en ,
                        "servicio"@es ,
                        "servizio"@it ,
                        "služba"@cs .


###  http://www.w3.org/ns/dcat#theme
dcat:theme rdf:type owl:ObjectProperty ;
           rdfs:label "emne"@da ,
                      "tema"@es ,
                      "tema"@it ,
                      "theme"@en ,
                      "thème"@fr ,
                      "téma"@cs ,
                      "Θέμα"@el ,
                      "التصنيف"@ar ,
                      "テーマ/カテゴリー"@ja .


###  http://www.w3.org/ns/odrl/2/action
odrl:action rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( odrl:Policy
                                        odrl:Rule
                                      )
                        ] ;
            rdfs:range odrl:Action .


###  http://www.w3.org/ns/odrl/2/constraint
odrl:constraint rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( odrl:Policy
                                            odrl:Rule
                                          )
                            ] ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( odrl:Constraint
                                           odrl:LogicalConstraint
                                         )
                           ] .


###  http://www.w3.org/ns/odrl/2/duty
odrl:duty rdf:type owl:ObjectProperty ;
          rdfs:domain odrl:Permission ;
          rdfs:range odrl:Duty .


###  http://www.w3.org/ns/odrl/2/hasPolicy
odrl:hasPolicy rdf:type owl:ObjectProperty ;
               rdfs:domain odrl:Asset ;
               rdfs:range odrl:Policy .


###  http://www.w3.org/ns/odrl/2/includedIn
odrl:includedIn rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:domain odrl:Action ;
                rdfs:range odrl:Action .


###  http://www.w3.org/ns/odrl/2/obligation
odrl:obligation rdf:type owl:ObjectProperty ;
                rdfs:domain odrl:Policy ;
                rdfs:range odrl:Duty .


###  http://www.w3.org/ns/odrl/2/permission
odrl:permission rdf:type owl:ObjectProperty ;
                rdfs:domain odrl:Policy ;
                rdfs:range odrl:Permission .


###  http://www.w3.org/ns/odrl/2/prohibition
odrl:prohibition rdf:type owl:ObjectProperty ;
                 rdfs:domain odrl:Policy ;
                 rdfs:range odrl:Prohibition .


###  http://www.w3.org/ns/odrl/2/relation
odrl:relation rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( odrl:Policy
                                          odrl:Rule
                                        )
                          ] ;
              rdfs:range odrl:Asset .


###  http://www.w3.org/ns/odrl/2/target
odrl:target rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf odrl:relation ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( odrl:Policy
                                        odrl:Rule
                                      )
                        ] ;
            rdfs:range odrl:Asset .


###  http://www.w3.org/ns/prov#alternateOf
prov:alternateOf rdf:type owl:ObjectProperty ;
                 rdfs:domain prov:Entity ;
                 rdfs:range prov:Entity ;
                 rdfs:label "alternateOf" .


###  http://www.w3.org/ns/prov#generalizationOf
prov:generalizationOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#influenced
prov:influenced rdf:type owl:ObjectProperty ;
                owl:inverseOf prov:wasInfluencedBy ;
                rdfs:label "influenced" .


###  http://www.w3.org/ns/prov#specializationOf
prov:specializationOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf prov:alternateOf ;
                      rdfs:domain prov:Entity ;
                      rdfs:label "specializationOf" .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf prov:wasInfluencedBy ;
                    rdfs:domain prov:Entity ;
                    rdfs:range prov:Entity ;
                    rdfs:label "wasDerivedFrom" .


###  http://www.w3.org/ns/prov#wasInfluencedBy
prov:wasInfluencedBy rdf:type owl:ObjectProperty ;
                     rdfs:label "wasInfluencedBy" .


###  http://www.w3.org/ns/prov#wasRevisionOf
prov:wasRevisionOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf prov:wasDerivedFrom ;
                   rdfs:domain prov:Entity ;
                   rdfs:label "wasRevisionOf" .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:DatatypeProperty .


###  http://www.w3.org/ns/dcat#byteSize
dcat:byteSize rdf:type owl:DatatypeProperty ;
              rdfs:domain dcat:Distribution ;
              rdfs:label "byte size"@en ,
                         "bytestørrelse"@da ,
                         "dimensione in byte"@it ,
                         "taille en octects"@fr ,
                         "tamaño en bytes"@es ,
                         "velikost v bajtech"@cs ,
                         "μέγεθος σε bytes"@el ,
                         "الحجم بالبايت"@ar ,
                         "バイト・サイズ"@ja .


###  http://www.w3.org/ns/dcat#keyword
dcat:keyword rdf:type owl:DatatypeProperty ;
             rdfs:label "keyword"@en ,
                        "klíčové slovo"@cs ,
                        "mot-clés "@fr ,
                        "nøgleord"@da ,
                        "palabra clave"@es ,
                        "parola chiave"@it ,
                        "λέξη-κλειδί"@el ,
                        "كلمة  مفتاحية "@ar ,
                        "キーワード/タグ"@ja .


###  http://www.w3.org/ns/dcat#spatialResolutionInMeters
dcat:spatialResolutionInMeters rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:decimal ;
                               rdfs:label "geografisk opløsning (meter)"@da ,
                                          "prostorové rozlišení (metry)"@cs ,
                                          "resolución espacial (metros)"@es ,
                                          "risoluzione spaziale (metri)"@it ,
                                          "spatial resolution (meters)"@en-us ,
                                          "spatial resolution (metres)"@en-gb .


###  http://www.w3.org/ns/dcat#temporalResolution
dcat:temporalResolution rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:duration ;
                        rdfs:label "resolución temporal"@es ,
                                   "risoluzione temporale"@it ,
                                   "temporal resolution"@en ,
                                   "tidslig opløsning"@da ,
                                   "časové rozlišení"@cs .


###  http://www.w3.org/ns/dcat#version
dcat:version rdf:type owl:DatatypeProperty ;
             rdfs:label "version"@en ,
                        "versione"@it ,
                        "versión"@es .


#################################################################
#    Classes
#################################################################

###  http://purl.org/dc/dcam/VocabularyEncodingScheme
<http://purl.org/dc/dcam/VocabularyEncodingScheme> rdf:type owl:Class .


###  http://purl.org/dc/dcmitype/Service
<http://purl.org/dc/dcmitype/Service> rdf:type owl:Class .


###  http://purl.org/dc/terms/AgentClass
dcterms:AgentClass rdf:type owl:Class ;
                   rdfs:subClassOf rdfs:Class ;
                   rdfs:label "Agent Class"@en .


###  http://purl.org/dc/terms/MediaType
dcterms:MediaType rdf:type owl:Class ;
                  rdfs:subClassOf dcterms:MediaTypeOrExtent ;
                  rdfs:label "Media Type"@en .


###  http://purl.org/dc/terms/MediaTypeOrExtent
dcterms:MediaTypeOrExtent rdf:type owl:Class ;
                          rdfs:label "Media Type or Extent"@en .


###  http://schema.org/Action
<http://schema.org/Action> rdf:type owl:Class .


###  http://schema.org/Organization
<http://schema.org/Organization> rdf:type owl:Class .


###  http://schema.org/Person
<http://schema.org/Person> rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Class
rdfs:Class rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Collection
skos:Collection rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2006/vcard/ns#Agent
<http://www.w3.org/2006/vcard/ns#Agent> rdf:type owl:Class .


###  http://www.w3.org/2006/vcard/ns#Individual
<http://www.w3.org/2006/vcard/ns#Individual> rdf:type owl:Class .


###  http://www.w3.org/2006/vcard/ns#Kind
<http://www.w3.org/2006/vcard/ns#Kind> rdf:type owl:Class .


###  http://www.w3.org/2006/vcard/ns#Organization
<http://www.w3.org/2006/vcard/ns#Organization> rdf:type owl:Class .


###  http://www.w3.org/ns/dcat#Catalog
dcat:Catalog rdf:type owl:Class ;
             rdfs:subClassOf dcat:Dataset ;
             rdfs:label "Catalog"@en ,
                        "Catalogo"@it ,
                        "Catalogue"@fr ,
                        "Catálogo"@es ,
                        "Katalog"@cs ,
                        "Katalog"@da ,
                        "Κατάλογος"@el ,
                        "فهرس قوائم البيانات"@ar ,
                        "カタログ"@ja .


###  http://www.w3.org/ns/dcat#DataService
dcat:DataService rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.org/dc/dcmitype/Service> ,
                                 dcat:Resource ;
                 rdfs:label "Data service"@en ,
                            "Datatjeneste"@da ,
                            "Servicio de datos"@es ,
                            "Servizio di dati"@it .


###  http://www.w3.org/ns/dcat#Dataset
dcat:Dataset rdf:type owl:Class ;
             rdfs:subClassOf dcat:Resource ;
             rdfs:label "Conjunto de datos"@es ,
                        "Dataset"@en ,
                        "Dataset"@it ,
                        "Datasæt"@da ,
                        "Datová sada"@cs ,
                        "Jeu de données"@fr ,
                        "Σύνολο Δεδομένων"@el ,
                        "قائمة بيانات"@ar ,
                        "データセット"@ja .


###  http://www.w3.org/ns/dcat#DatasetSeries
dcat:DatasetSeries rdf:type owl:Class ;
                   rdfs:subClassOf dcat:Dataset ;
                   rdfs:label "Dataset series"@en ,
                              "Serie de conjuntos de datos"@es ,
                              "Serie di dataset"@it .


###  http://www.w3.org/ns/dcat#Distribution
dcat:Distribution rdf:type owl:Class ;
                  rdfs:label "Distribuce"@cs ,
                             "Distribución"@es ,
                             "Distribution"@da ,
                             "Distribution"@en ,
                             "Distribution"@fr ,
                             "Distribuzione"@it ,
                             "Διανομή"@el ,
                             "التوزيع"@ar ,
                             "配信"@ja .


###  http://www.w3.org/ns/dcat#Resource
dcat:Resource rdf:type owl:Class ;
              rdfs:label "Catalogued resource"@en ,
                         "Katalogiseret ressource"@da ,
                         "Katalogizovaný zdroj"@cs ,
                         "Recurso catalogado"@es ,
                         "Risorsa catalogata"@it .


###  http://www.w3.org/ns/odrl/2/Action
odrl:Action rdf:type owl:Class ;
            rdfs:subClassOf <http://schema.org/Action> .


###  http://www.w3.org/ns/odrl/2/Agreement
odrl:Agreement rdf:type owl:Class ;
               rdfs:subClassOf odrl:Policy ;
               owl:disjointWith odrl:Offer ,
                                odrl:Set .


###  http://www.w3.org/ns/odrl/2/Asset
odrl:Asset rdf:type owl:Class .


###  http://www.w3.org/ns/odrl/2/ConflictTerm
odrl:ConflictTerm rdf:type owl:Class .


###  http://www.w3.org/ns/odrl/2/Constraint
odrl:Constraint rdf:type owl:Class .


###  http://www.w3.org/ns/odrl/2/Duty
odrl:Duty rdf:type owl:Class ;
          rdfs:subClassOf odrl:Rule ;
          owl:disjointWith odrl:Permission ,
                           odrl:Prohibition .


###  http://www.w3.org/ns/odrl/2/LeftOperand
odrl:LeftOperand rdf:type owl:Class .


###  http://www.w3.org/ns/odrl/2/LogicalConstraint
odrl:LogicalConstraint rdf:type owl:Class .


###  http://www.w3.org/ns/odrl/2/Offer
odrl:Offer rdf:type owl:Class ;
           rdfs:subClassOf odrl:Policy ;
           owl:disjointWith odrl:Set .


###  http://www.w3.org/ns/odrl/2/Operator
odrl:Operator rdf:type owl:Class .


###  http://www.w3.org/ns/odrl/2/Party
odrl:Party rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Class ;
                             owl:unionOf ( <http://schema.org/Organization>
                                           <http://schema.org/Person>
                                           <http://www.w3.org/2006/vcard/ns#Agent>
                                           <http://www.w3.org/2006/vcard/ns#Individual>
                                           <http://www.w3.org/2006/vcard/ns#Organization>
                                           foaf:Agent
                                           foaf:Organization
                                           foaf:Person
                                         )
                           ] .


