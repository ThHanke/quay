@base <https://w3id.org/quay.ttl> .

<https://w3id.org/quay.ttl> rdf:type owl:Ontology ;
                             owl:versionIRI <https://w3id.org/quay//releases/2026-08-17/quay.ttl> ;
                             dcterms:description """A DCAT Profile for Data Access, Storage and Authorization Metadata.
""" ;
                             dcterms:license <https://w3id.org/quay.owl#CC-BY-4.0> ;
                             dcterms:title "QUAY: Qualified Usage, Access and Yield" ;
                             owl:versionInfo "2026-08-17" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/source
dce:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/hasVersion
dcterms:hasVersion rdf:type owl:ObjectProperty .


###  http://purl.org/pav/hasVersion
<http://purl.org/pav/hasVersion> rdf:type owl:ObjectProperty ;
                                 owl:equivalentProperty dcat:hasVersion .


###  http://www.w3.org/ns/dcat#hasCurrentVersion
dcat:hasCurrentVersion rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.org/pav/hasVersion> ;
                       rdfs:label "ha versione attuale"@it ,
                                  "has current version"@en ,
                                  "tiene versión actual"@es .


###  http://www.w3.org/ns/dcat#hasVersion
dcat:hasVersion rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf dcterms:hasVersion ,
                                   prov:generalizationOf ;
                owl:inverseOf dcat:isVersionOf ;
                rdfs:label "ha versione"@it ,
                           "has version"@en ,
                           "tiene versión"@es .


###  http://www.w3.org/ns/dcat#isVersionOf
dcat:isVersionOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#nextVersion
dcat:nextVersion rdf:type owl:ObjectProperty ;
                 owl:inverseOf dcat:previousVersion .


###  http://www.w3.org/ns/dcat#previousVersion
dcat:previousVersion rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf prov:wasRevisionOf ;
                     rdfs:label "previous version"@en ,
                                "versione precedente"@it ,
                                "versión anterior"@es .


###  http://www.w3.org/ns/odrl/2/includedIn
odrl:includedIn rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:domain odrl:Action ;
                rdfs:range odrl:Action .


###  http://www.w3.org/ns/prov#generalizationOf
prov:generalizationOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasRevisionOf
prov:wasRevisionOf rdf:type owl:ObjectProperty .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:DatatypeProperty .


###  http://www.w3.org/ns/dcat#version
dcat:version rdf:type owl:DatatypeProperty ;
             rdfs:label "version"@en ,
                        "versione"@it ,
                        "versión"@es .


