@prefix : <https://w3id.org/quay/quay-full.ttl#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dce: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfa: <http://www.w3.org/ns/rdfa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@base <https://w3id.org/quay/quay-full.ttl> .

<https://w3id.org/quay/quay-full.ttl> rdf:type owl:Ontology ;
                                       owl:versionIRI <https://w3id.org/quay/releases/2026-08-18/quay-full.ttl> ;
                                       dcterms:description "A DCAT Profile for Data Access, Storage and Authorization Metadata." ;
                                       dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                       dcterms:title "QUAY: Qualified Usage, Access and Yield" ;
                                       owl:versionInfo "2026-08-18" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.obolibrary.org/obo/IAO_0000115
obo:IAO_0000115 rdf:type owl:AnnotationProperty ;
                rdfs:label "definition" .


###  http://purl.org/dc/elements/1.1/source
dce:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/pav/hasVersion
<http://purl.org/pav/hasVersion> rdf:type owl:ObjectProperty ;
                                 owl:equivalentProperty dcat:hasVersion .


###  http://spdx.org/rdf/terms#algorithm
spdx:algorithm rdf:type owl:ObjectProperty .


###  http://spdx.org/rdf/terms#checksum
spdx:checksum rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#accessService
dcat:accessService rdf:type owl:ObjectProperty ;
                   rdfs:range dcat:DataService ;
                   rdfs:label "data access service"@en ,
                              "dataadgangstjeneste"@da ,
                              "servicio de acceso de datos"@es ,
                              "servizio di accesso ai dati"@it ,
                              "služba pro přístup k datům"@cs .


###  http://www.w3.org/ns/dcat#accessURL
dcat:accessURL rdf:type owl:ObjectProperty ;
               rdfs:domain dcat:Distribution ;
               rdfs:range rdfs:Resource ;
               owl:propertyChainAxiom ( dcat:accessService
                                        dcat:endpointURL
                                      ) ;
               rdfs:label "URL d'accès"@fr ,
                          "URL de acceso"@es ,
                          "URL πρόσβασης"@el ,
                          "access address"@en ,
                          "adgangsadresse"@da ,
                          "indirizzo di accesso"@it ,
                          "přístupová adresa"@cs ,
                          "رابط وصول"@ar ,
                          "アクセスURL"@ja .


###  http://www.w3.org/ns/dcat#catalog
dcat:catalog rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcat:resource ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:Catalog ;
             rdfs:label "catalog"@en ,
                        "catalogo"@it ,
                        "catálogo"@es ,
                        "katalog"@cs ,
                        "katalog"@da .


###  http://www.w3.org/ns/dcat#compressFormat
dcat:compressFormat rdf:type owl:ObjectProperty ;
                    rdfs:domain dcat:Distribution ;
                    rdfs:range dcterms:MediaType ;
                    rdfs:label "compression format"@en ,
                               "formato de compresión"@es ,
                               "formato di compressione"@it ,
                               "formát komprese"@cs ,
                               "kompressionsformat"@da .


###  http://www.w3.org/ns/dcat#contactPoint
dcat:contactPoint rdf:type owl:ObjectProperty ;
                  rdfs:range <http://www.w3.org/2006/vcard/ns#Kind> ;
                  rdfs:label "Punto de contacto"@es ,
                             "contact point"@en ,
                             "kontaktní bod"@cs ,
                             "kontaktpunkt"@da ,
                             "point de contact"@fr ,
                             "punto di contatto"@it ,
                             "σημείο επικοινωνίας"@el ,
                             "عنوان اتصال"@ar ,
                             "窓口"@ja .


###  http://www.w3.org/ns/dcat#dataset
dcat:dataset rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcat:resource ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:Dataset ;
             rdfs:label "conjunto de datos"@es ,
                        "dataset"@en ,
                        "dataset"@it ,
                        "datasæt"@da ,
                        "datová sada"@cs ,
                        "jeu de données"@fr ,
                        "σύνολο δεδομένων"@el ,
                        "قائمة بيانات"@ar ,
                        "データセット"@ja .


###  http://www.w3.org/ns/dcat#distribution
dcat:distribution rdf:type owl:ObjectProperty ;
                  owl:inverseOf dcat:isDistributionOf ;
                  rdfs:domain dcat:Dataset ;
                  rdfs:range dcat:Distribution ;
                  rdfs:label "distribuce"@cs ,
                             "distribución"@es ,
                             "distribution"@da ,
                             "distribution"@en ,
                             "distribution"@fr ,
                             "distribuzione"@it ,
                             "διανομή"@el ,
                             "توزيع"@ar ,
                             "データセット配信"@ja .


###  http://www.w3.org/ns/dcat#downloadURL
dcat:downloadURL rdf:type owl:ObjectProperty ;
                 rdfs:domain dcat:Distribution ;
                 rdfs:range rdfs:Resource ;
                 rdfs:label "URL de descarga"@es ,
                            "URL de téléchargement"@fr ,
                            "URL di scarico"@it ,
                            "URL souboru ke stažení"@cs ,
                            "URL μεταφόρτωσης"@el ,
                            "download URL"@en ,
                            "downloadURL"@da ,
                            "رابط تحميل"@ar ,
                            "ダウンロードURL"@ja .


###  http://www.w3.org/ns/dcat#endpointDescription
dcat:endpointDescription rdf:type owl:ObjectProperty ;
                         rdfs:domain dcat:DataService ;
                         rdfs:label "descripción del end-point del servicio"@es ,
                                    "description of service end-point"@en ,
                                    "descrizione dell'endpoint del servizio"@it ,
                                    "endpointbeskrivelse"@da ,
                                    "popis přístupového bodu služby"@cs .


###  http://www.w3.org/ns/dcat#endpointURL
dcat:endpointURL rdf:type owl:ObjectProperty ;
                 rdfs:domain dcat:DataService ;
                 rdfs:range rdfs:Resource ;
                 rdfs:label "end-point del servicio"@es ,
                            "end-point del servizio"@it ,
                            "přístupový bod služby"@cs ,
                            "service end-point"@en ,
                            "tjenesteendpoint"@da .


###  http://www.w3.org/ns/dcat#hasCurrentVersion
dcat:hasCurrentVersion rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.org/pav/hasVersion> ;
                       rdfs:label "ha versione attuale"@it ,
                                  "has current version"@en ,
                                  "tiene versión actual"@es .


###  http://www.w3.org/ns/dcat#hasVersion
dcat:hasVersion rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf prov:generalizationOf ;
                owl:inverseOf dcat:isVersionOf ;
                rdfs:label "ha versione"@it ,
                           "has version"@en ,
                           "tiene versión"@es .


###  http://www.w3.org/ns/dcat#inCatalog
dcat:inCatalog rdf:type owl:ObjectProperty ;
               owl:inverseOf dcat:resource .


###  http://www.w3.org/ns/dcat#inSeries
dcat:inSeries rdf:type owl:ObjectProperty ;
              owl:inverseOf dcat:seriesMember ;
              rdfs:label "en serie"@es ,
                         "in serie"@it ,
                         "in series"@en .


###  http://www.w3.org/ns/dcat#isDistributionOf
dcat:isDistributionOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#isVersionOf
dcat:isVersionOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#mediaType
dcat:mediaType rdf:type owl:ObjectProperty ;
               rdfs:domain dcat:Distribution ;
               rdfs:range dcterms:MediaType ;
               rdfs:label "media type"@en ,
                          "medietype"@da ,
                          "tipo de media"@es ,
                          "tipo di media"@it ,
                          "typ média"@cs ,
                          "type de média"@fr ,
                          "τύπος μέσου"@el ,
                          "نوع الميديا"@ar ,
                          "メディア・タイプ"@ja .


###  http://www.w3.org/ns/dcat#nextVersion
dcat:nextVersion rdf:type owl:ObjectProperty ;
                 owl:inverseOf dcat:previousVersion .


###  http://www.w3.org/ns/dcat#packageFormat
dcat:packageFormat rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:Distribution ;
                   rdfs:range dcterms:MediaType ;
                   rdfs:label "formato de empaquetado"@es ,
                              "formato di impacchettamento"@it ,
                              "formát balíčku"@cs ,
                              "packaging format"@en ,
                              "pakkeformat"@da .


###  http://www.w3.org/ns/dcat#previousVersion
dcat:previousVersion rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf prov:wasRevisionOf ;
                     rdfs:label "previous version"@en ,
                                "versione precedente"@it ,
                                "versión anterior"@es .


###  http://www.w3.org/ns/dcat#resource
dcat:resource rdf:type owl:ObjectProperty ;
              rdfs:domain dcat:Catalog ;
              rdfs:range dcat:Resource ;
              rdfs:label "resource"@en ,
                         "risorsa"@it .


###  http://www.w3.org/ns/dcat#seriesMember
dcat:seriesMember rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#servesDataset
dcat:servesDataset rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:DataService ;
                   rdfs:range dcat:Dataset ;
                   rdfs:label "datatjeneste for datasæt"@da ,
                              "poskytuje datovou sadu"@cs ,
                              "provee conjunto de datos"@es ,
                              "serve set di dati"@it ,
                              "serves dataset"@en .


###  http://www.w3.org/ns/dcat#service
dcat:service rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcat:resource ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:DataService ;
             rdfs:label "datatjeneste"@da ,
                        "service"@en ,
                        "servicio"@es ,
                        "servizio"@it ,
                        "služba"@cs .


###  http://www.w3.org/ns/dcat#theme
dcat:theme rdf:type owl:ObjectProperty ;
           rdfs:label "emne"@da ,
                      "tema"@es ,
                      "tema"@it ,
                      "theme"@en ,
                      "thème"@fr ,
                      "téma"@cs ,
                      "Θέμα"@el ,
                      "التصنيف"@ar ,
                      "テーマ/カテゴリー"@ja .


###  http://www.w3.org/ns/odrl/2/action
odrl:action rdf:type owl:ObjectProperty ;
            rdfs:range odrl:Action .


###  http://www.w3.org/ns/odrl/2/constraint
odrl:constraint rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/odrl/2/duty
odrl:duty rdf:type owl:ObjectProperty ;
          rdfs:domain odrl:Permission ;
          rdfs:range odrl:Duty .


###  http://www.w3.org/ns/odrl/2/hasPolicy
odrl:hasPolicy rdf:type owl:ObjectProperty ;
               rdfs:range odrl:Policy .


###  http://www.w3.org/ns/odrl/2/includedIn
odrl:includedIn rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:domain odrl:Action ;
                rdfs:range odrl:Action ;
                rdfs:label "Included In"@en .


###  http://www.w3.org/ns/odrl/2/leftOperand
odrl:leftOperand rdf:type owl:ObjectProperty ;
                 rdfs:domain odrl:Constraint ;
                 rdfs:range odrl:LeftOperand .


###  http://www.w3.org/ns/odrl/2/operator
odrl:operator rdf:type owl:ObjectProperty ;
              rdfs:domain odrl:Constraint .


###  http://www.w3.org/ns/odrl/2/permission
odrl:permission rdf:type owl:ObjectProperty ;
                rdfs:domain odrl:Policy ;
                rdfs:range odrl:Permission .


###  http://www.w3.org/ns/odrl/2/prohibition
odrl:prohibition rdf:type owl:ObjectProperty ;
                 rdfs:domain odrl:Policy ;
                 rdfs:range odrl:Prohibition .


###  http://www.w3.org/ns/odrl/2/rightOperand
odrl:rightOperand rdf:type owl:ObjectProperty ;
                  rdfs:domain odrl:Constraint .


###  http://www.w3.org/ns/odrl/2/target
odrl:target rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#alternateOf
prov:alternateOf rdf:type owl:ObjectProperty ;
                 rdfs:domain prov:Entity ;
                 rdfs:range prov:Entity ;
                 rdfs:label "alternateOf" .


###  http://www.w3.org/ns/prov#generalizationOf
prov:generalizationOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#influenced
prov:influenced rdf:type owl:ObjectProperty ;
                owl:inverseOf prov:wasInfluencedBy ;
                rdfs:label "influenced" .


###  http://www.w3.org/ns/prov#specializationOf
prov:specializationOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf prov:alternateOf ;
                      rdfs:domain prov:Entity ;
                      rdfs:label "specializationOf" .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf prov:wasInfluencedBy ;
                    rdfs:domain prov:Entity ;
                    rdfs:range prov:Entity ;
                    rdfs:label "wasDerivedFrom" .


###  http://www.w3.org/ns/prov#wasInfluencedBy
prov:wasInfluencedBy rdf:type owl:ObjectProperty ;
                     rdfs:label "wasInfluencedBy" .


###  http://www.w3.org/ns/prov#wasRevisionOf
prov:wasRevisionOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf prov:wasDerivedFrom ;
                   rdfs:domain prov:Entity ;
                   rdfs:label "wasRevisionOf" .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:ObjectProperty .


###  https://w3id.org/quay.owl#accessDescription
<https://w3id.org/quay.owl#accessDescription> rdf:type owl:ObjectProperty .


###  https://w3id.org/quay.owl#authenticationScheme
<https://w3id.org/quay.owl#authenticationScheme> rdf:type owl:ObjectProperty .


###  https://w3id.org/quay.owl#coverage
<https://w3id.org/quay.owl#coverage> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/quay.owl#YieldDescription> ;
                                     rdfs:range <https://w3id.org/quay.owl#Coverage> ;
                                     rdfs:label "coverage" .


###  https://w3id.org/quay.owl#deliveryMode
<https://w3id.org/quay.owl#deliveryMode> rdf:type owl:ObjectProperty .


###  https://w3id.org/quay.owl#encryptionAtRest
<https://w3id.org/quay.owl#encryptionAtRest> rdf:type owl:ObjectProperty ;
                                             rdfs:domain dcat:Distribution ;
                                             rdfs:range <https://w3id.org/quay.owl#EncryptionAlgorithm> ;
                                             obo:IAO_0000115 "Relates a distribution to the encryption algorithm applied to data at rest within the storage backend." ;
                                             rdfs:label "encryption at rest" .


###  https://w3id.org/quay.owl#encryptionInTransit
<https://w3id.org/quay.owl#encryptionInTransit> rdf:type owl:ObjectProperty ;
                                                rdfs:domain dcat:Distribution ;
                                                rdfs:range <https://w3id.org/quay.owl#EncryptionAlgorithm> ;
                                                obo:IAO_0000115 "Relates a distribution to the encryption protocol applied to data during transfer between client and server." ;
                                                rdfs:label "encryption in transit" .


###  https://w3id.org/quay.owl#protocol
<https://w3id.org/quay.owl#protocol> rdf:type owl:ObjectProperty .


###  https://w3id.org/quay.owl#serviceQuality
<https://w3id.org/quay.owl#serviceQuality> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/quay.owl#YieldDescription> ;
                                           rdfs:range <https://w3id.org/quay.owl#ServiceQuality> ;
                                           rdfs:label "service quality" .


###  https://w3id.org/quay.owl#storageJurisdiction
<https://w3id.org/quay.owl#storageJurisdiction> rdf:type owl:ObjectProperty ;
                                                rdfs:domain dcat:Distribution ;
                                                rdfs:range rdfs:Resource ;
                                                obo:IAO_0000115 "Relates a distribution to the legal jurisdiction or geographic region where data is physically stored." ;
                                                rdfs:label "storage jurisdiction" .


###  https://w3id.org/quay.owl#supportedOperation
<https://w3id.org/quay.owl#supportedOperation> rdf:type owl:ObjectProperty .


###  https://w3id.org/quay.owl#temporalQuality
<https://w3id.org/quay.owl#temporalQuality> rdf:type owl:ObjectProperty .


###  https://w3id.org/quay.owl#verificationMethod
<https://w3id.org/quay.owl#verificationMethod> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/quay.owl#YieldDescription> ;
                                               rdfs:range <https://w3id.org/quay.owl#VerificationMethod> ;
                                               rdfs:label "verification method" .


###  https://w3id.org/quay.owl#yieldDescription
<https://w3id.org/quay.owl#yieldDescription> rdf:type owl:ObjectProperty .


###  https://w3id.org/quay/accessDescription
<https://w3id.org/quay/accessDescription> rdf:type owl:ObjectProperty ;
                                          rdfs:domain dcat:Distribution ;
                                          rdfs:range <https://w3id.org/quay/AccessDescription> ;
                                          obo:IAO_0000115 "Relates a distribution to a qualification node that describes how it is accessed." ;
                                          rdfs:label "access description" .


###  https://w3id.org/quay/authenticationScheme
<https://w3id.org/quay/authenticationScheme> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/quay/AccessDescription> ;
                                             rdfs:range <https://w3id.org/quay/AuthenticationScheme> ;
                                             obo:IAO_0000115 "Relates an access description to the method used to verify the identity of the accessing agent." ;
                                             rdfs:label "authentication scheme" .


###  https://w3id.org/quay/coverage
<https://w3id.org/quay/coverage> rdf:type owl:ObjectProperty ;
                                 rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                 rdfs:range <https://w3id.org/quay/Coverage> ;
                                 obo:IAO_0000115 "Relates a yield description to the extent of dataset representation in the distribution." ;
                                 rdfs:label "coverage" .


###  https://w3id.org/quay/deliveryMode
<https://w3id.org/quay/deliveryMode> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                     rdfs:range <https://w3id.org/quay/DeliveryMode> ;
                                     obo:IAO_0000115 "Relates a yield description to the mechanism by which data is transferred to the consumer." ;
                                     rdfs:label "delivery mode" .


###  https://w3id.org/quay/protocol
<https://w3id.org/quay/protocol> rdf:type owl:ObjectProperty ;
                                 rdfs:domain <https://w3id.org/quay/AccessDescription> ;
                                 rdfs:range <https://w3id.org/quay/Protocol> ;
                                 obo:IAO_0000115 "Relates an access description to the communication protocol used for data exchange." ;
                                 rdfs:label "protocol" .


###  https://w3id.org/quay/serviceQuality
<https://w3id.org/quay/serviceQuality> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                       rdfs:range <https://w3id.org/quay/ServiceQuality> ;
                                       obo:IAO_0000115 "Relates a yield description to the reliability and availability characterisation of the service." ;
                                       rdfs:label "service quality" .


###  https://w3id.org/quay/supportedOperation
<https://w3id.org/quay/supportedOperation> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/quay/AccessDescription> ;
                                           rdfs:range <https://w3id.org/quay/Operation> ;
                                           obo:IAO_0000115 "Relates an access description to an action that can be performed on the data resource." ;
                                           rdfs:label "supported operation" .


###  https://w3id.org/quay/temporalQuality
<https://w3id.org/quay/temporalQuality> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                        rdfs:range <https://w3id.org/quay/TemporalQuality> ;
                                        obo:IAO_0000115 "Relates a yield description to the freshness characterisation of the available data." ;
                                        rdfs:label "temporal quality" .


###  https://w3id.org/quay/verificationMethod
<https://w3id.org/quay/verificationMethod> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/quay/YieldDescription> ;
                                           rdfs:range <https://w3id.org/quay/VerificationMethod> ;
                                           obo:IAO_0000115 "Relates a yield description to the mechanism used to verify data integrity after transfer." ;
                                           rdfs:label "verification method" .


###  https://w3id.org/quay/yieldDescription
<https://w3id.org/quay/yieldDescription> rdf:type owl:ObjectProperty ;
                                         rdfs:domain dcat:Distribution ;
                                         rdfs:range <https://w3id.org/quay/YieldDescription> ;
                                         obo:IAO_0000115 "Relates a distribution to a qualification node that describes what it delivers." ;
                                         rdfs:label "yield description" .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:DatatypeProperty .


###  http://spdx.org/rdf/terms#checksumValue
spdx:checksumValue rdf:type owl:DatatypeProperty .


###  http://www.w3.org/ns/dcat#byteSize
dcat:byteSize rdf:type owl:DatatypeProperty ;
              rdfs:domain dcat:Distribution ;
              rdfs:label "byte size"@en ,
                         "bytestørrelse"@da ,
                         "dimensione in byte"@it ,
                         "taille en octects"@fr ,
                         "tamaño en bytes"@es ,
                         "velikost v bajtech"@cs ,
                         "μέγεθος σε bytes"@el ,
                         "الحجم بالبايت"@ar ,
                         "バイト・サイズ"@ja .


###  http://www.w3.org/ns/dcat#keyword
dcat:keyword rdf:type owl:DatatypeProperty ;
             rdfs:label "keyword"@en ,
                        "klíčové slovo"@cs ,
                        "mot-clés "@fr ,
                        "nøgleord"@da ,
                        "palabra clave"@es ,
                        "parola chiave"@it ,
                        "λέξη-κλειδί"@el ,
                        "كلمة  مفتاحية "@ar ,
                        "キーワード/タグ"@ja .


