# Annotation Property: obo:IAO_0000115 (definition)

AnnotationAssertion(rdfs:label obo:IAO_0000115 "definition")

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (Title)

AnnotationAssertion(rdfs:label dcterms:title "title")


############################
#   Object Properties
############################

# Object Property: :accessDescription (access description)

AnnotationAssertion(obo:IAO_0000115 :accessDescription "Relates a distribution to a qualification node that describes how it is accessed.")
AnnotationAssertion(rdfs:label :accessDescription "access description")
ObjectPropertyDomain(:accessDescription dcat:Distribution)
ObjectPropertyRange(:accessDescription :AccessDescription)

# Object Property: :authenticationScheme (authentication scheme)

AnnotationAssertion(obo:IAO_0000115 :authenticationScheme "Relates an access description to the method used to verify the identity of the accessing agent.")
AnnotationAssertion(rdfs:label :authenticationScheme "authentication scheme")
ObjectPropertyDomain(:authenticationScheme :AccessDescription)
ObjectPropertyRange(:authenticationScheme :AuthenticationScheme)

# Object Property: :coverage (coverage)

AnnotationAssertion(obo:IAO_0000115 :coverage "Relates a yield description to the extent of dataset representation in the distribution.")
AnnotationAssertion(rdfs:label :coverage "coverage")
ObjectPropertyDomain(:coverage :YieldDescription)
ObjectPropertyRange(:coverage :Coverage)

# Object Property: :deliveryMode (delivery mode)

AnnotationAssertion(obo:IAO_0000115 :deliveryMode "Relates a yield description to the mechanism by which data is transferred to the consumer.")
AnnotationAssertion(rdfs:label :deliveryMode "delivery mode")
ObjectPropertyDomain(:deliveryMode :YieldDescription)
ObjectPropertyRange(:deliveryMode :DeliveryMode)

# Object Property: :encryptionAtRest (encryption at rest)

AnnotationAssertion(obo:IAO_0000115 :encryptionAtRest "Relates a distribution to the encryption algorithm applied to data at rest within the storage backend.")
AnnotationAssertion(rdfs:label :encryptionAtRest "encryption at rest")
ObjectPropertyDomain(:encryptionAtRest dcat:Distribution)
ObjectPropertyRange(:encryptionAtRest :EncryptionAlgorithm)

# Object Property: :encryptionInTransit (encryption in transit)

AnnotationAssertion(obo:IAO_0000115 :encryptionInTransit "Relates a distribution to the encryption protocol applied to data during transfer between client and server.")
AnnotationAssertion(rdfs:label :encryptionInTransit "encryption in transit")
ObjectPropertyDomain(:encryptionInTransit dcat:Distribution)
ObjectPropertyRange(:encryptionInTransit :EncryptionAlgorithm)

# Object Property: :protocol (protocol)

AnnotationAssertion(obo:IAO_0000115 :protocol "Relates an access description to the communication protocol used for data exchange.")
AnnotationAssertion(rdfs:label :protocol "protocol")
ObjectPropertyDomain(:protocol :AccessDescription)
ObjectPropertyRange(:protocol :Protocol)

# Object Property: :serviceQuality (service quality)

AnnotationAssertion(obo:IAO_0000115 :serviceQuality "Relates a yield description to the reliability and availability characterisation of the service.")
AnnotationAssertion(rdfs:label :serviceQuality "service quality")
ObjectPropertyDomain(:serviceQuality :YieldDescription)
ObjectPropertyRange(:serviceQuality :ServiceQuality)

# Object Property: :storageJurisdiction (storage jurisdiction)

AnnotationAssertion(obo:IAO_0000115 :storageJurisdiction "Relates a distribution to the legal jurisdiction or geographic region where data is physically stored.")
AnnotationAssertion(rdfs:label :storageJurisdiction "storage jurisdiction")
ObjectPropertyDomain(:storageJurisdiction dcat:Distribution)
ObjectPropertyRange(:storageJurisdiction rdfs:Resource)

# Object Property: :supportedOperation (supported operation)

AnnotationAssertion(obo:IAO_0000115 :supportedOperation "Relates an access description to an action that can be performed on the data resource.")
AnnotationAssertion(rdfs:label :supportedOperation "supported operation")
ObjectPropertyDomain(:supportedOperation :AccessDescription)
ObjectPropertyRange(:supportedOperation :Operation)

# Object Property: :temporalQuality (temporal quality)

AnnotationAssertion(obo:IAO_0000115 :temporalQuality "Relates a yield description to the freshness characterisation of the available data.")
AnnotationAssertion(rdfs:label :temporalQuality "temporal quality")
ObjectPropertyDomain(:temporalQuality :YieldDescription)
ObjectPropertyRange(:temporalQuality :TemporalQuality)

# Object Property: :verificationMethod (verification method)

AnnotationAssertion(obo:IAO_0000115 :verificationMethod "Relates a yield description to the mechanism used to verify data integrity after transfer.")
AnnotationAssertion(rdfs:label :verificationMethod "verification method")
ObjectPropertyDomain(:verificationMethod :YieldDescription)
ObjectPropertyRange(:verificationMethod :VerificationMethod)

# Object Property: :yieldDescription (yield description)

AnnotationAssertion(obo:IAO_0000115 :yieldDescription "Relates a distribution to a qualification node that describes what it delivers.")
AnnotationAssertion(rdfs:label :yieldDescription "yield description")
ObjectPropertyDomain(:yieldDescription dcat:Distribution)
ObjectPropertyRange(:yieldDescription :YieldDescription)


############################
#   Data Properties
############################

# Data Property: :costDescription (cost description)

AnnotationAssertion(obo:IAO_0000115 :costDescription "Human-readable description of the cost or pricing model for accessing the distribution.")
AnnotationAssertion(rdfs:label :costDescription "cost description")
DataPropertyDomain(:costDescription :AccessDescription)
DataPropertyRange(:costDescription xsd:string)

# Data Property: :quotaLimit (quota limit)

AnnotationAssertion(obo:IAO_0000115 :quotaLimit "Usage quota describing the maximum allowed consumption of the service.")
AnnotationAssertion(rdfs:label :quotaLimit "quota limit")
DataPropertyDomain(:quotaLimit :AccessDescription)
DataPropertyRange(:quotaLimit xsd:string)

# Data Property: :rateLimit (rate limit)

AnnotationAssertion(obo:IAO_0000115 :rateLimit "Maximum number of requests permitted within a time window.")
AnnotationAssertion(rdfs:label :rateLimit "rate limit")
DataPropertyDomain(:rateLimit :AccessDescription)
DataPropertyRange(:rateLimit xsd:nonNegativeInteger)

# Data Property: :recoveryPointObjective (recovery point objective)

AnnotationAssertion(obo:IAO_0000115 :recoveryPointObjective "Maximum acceptable duration of data loss measured as a time window before the disruption.")
AnnotationAssertion(rdfs:label :recoveryPointObjective "recovery point objective")
DataPropertyDomain(:recoveryPointObjective :YieldDescription)
DataPropertyRange(:recoveryPointObjective xsd:duration)

# Data Property: :recoveryTimeObjective (recovery time objective)

AnnotationAssertion(obo:IAO_0000115 :recoveryTimeObjective "Maximum acceptable duration to restore service after a disruption.")
AnnotationAssertion(rdfs:label :recoveryTimeObjective "recovery time objective")
DataPropertyDomain(:recoveryTimeObjective :YieldDescription)
DataPropertyRange(:recoveryTimeObjective xsd:duration)

# Data Property: :replicationFactor (replication factor)

AnnotationAssertion(obo:IAO_0000115 :replicationFactor "Number of independent copies of the data maintained across storage nodes.")
AnnotationAssertion(rdfs:label :replicationFactor "replication factor")
DataPropertyDomain(:replicationFactor :YieldDescription)
DataPropertyRange(:replicationFactor xsd:nonNegativeInteger)

# Data Property: :retentionPeriod (retention period)

AnnotationAssertion(obo:IAO_0000115 :retentionPeriod "Duration for which data is guaranteed to be retained before deletion or archival.")
AnnotationAssertion(rdfs:label :retentionPeriod "retention period")
DataPropertyDomain(:retentionPeriod dcat:Distribution)
DataPropertyRange(:retentionPeriod xsd:duration)

# Data Property: :uptimePercentage (uptime percentage)

AnnotationAssertion(obo:IAO_0000115 :uptimePercentage "Percentage of time the service is operational and accessible, expressed as a decimal value between 0 and 100.")
AnnotationAssertion(rdfs:label :uptimePercentage "uptime percentage")
DataPropertyDomain(:uptimePercentage :YieldDescription)
DataPropertyRange(:uptimePercentage xsd:decimal)



############################
#   Classes
############################

# Class: :AccessDescription (Access Description)

AnnotationAssertion(obo:IAO_0000115 :AccessDescription "Qualification node that specifies how a distribution is reached, comprising exactly one protocol, at least one authentication scheme, and at least one supported operation.")
AnnotationAssertion(rdfs:comment :AccessDescription "Qualifies HOW a Distribution is reached.")
AnnotationAssertion(rdfs:label :AccessDescription "Access Description")
SubClassOf(:AccessDescription ObjectSomeValuesFrom(:authenticationScheme :AuthenticationScheme))
SubClassOf(:AccessDescription ObjectSomeValuesFrom(:supportedOperation :Operation))
SubClassOf(:AccessDescription ObjectExactCardinality(1 :protocol :Protocol))

# Class: :Aes128Encryption (AES-128 Encryption)

AnnotationAssertion(obo:IAO_0000115 :Aes128Encryption "Encryption using the Advanced Encryption Standard with a 128-bit key.")
AnnotationAssertion(rdfs:comment :Aes128Encryption "128-bit Advanced Encryption Standard.")
AnnotationAssertion(rdfs:label :Aes128Encryption "AES-128 Encryption")
SubClassOf(:Aes128Encryption :EncryptionAlgorithm)

# Class: :Aes256Encryption (AES-256 Encryption)

AnnotationAssertion(obo:IAO_0000115 :Aes256Encryption "Encryption using the Advanced Encryption Standard with a 256-bit key.")
AnnotationAssertion(rdfs:comment :Aes256Encryption "256-bit Advanced Encryption Standard.")
AnnotationAssertion(rdfs:label :Aes256Encryption "AES-256 Encryption")
SubClassOf(:Aes256Encryption :EncryptionAlgorithm)

# Class: :ApiKeyAuthentication (API Key)

AnnotationAssertion(obo:IAO_0000115 :ApiKeyAuthentication "Authentication scheme that verifies identity by presenting a pre-shared secret key with each request.")
AnnotationAssertion(rdfs:label :ApiKeyAuthentication "API Key")
AnnotationAssertion(rdfs:label :ApiKeyAuthentication "API Key Authentication")
SubClassOf(:ApiKeyAuthentication :AuthenticationScheme)

# Class: :Archived (Archived)

AnnotationAssertion(obo:IAO_0000115 :Archived "Temporal quality in which data is preserved for long-term retention and is no longer actively updated.")
AnnotationAssertion(rdfs:label :Archived "Archived")
SubClassOf(:Archived :TemporalQuality)

# Class: :AuthenticationScheme (Authentication Scheme)

AnnotationAssertion(obo:IAO_0000115 :AuthenticationScheme "Method used to verify the identity of an agent requesting access to a data resource.")
AnnotationAssertion(rdfs:label :AuthenticationScheme "Authentication Scheme")

# Class: :AwsCredentialAuthentication (AWS Credential)

AnnotationAssertion(obo:IAO_0000115 :AwsCredentialAuthentication "Authentication scheme that verifies identity using an AWS access key identifier and secret access key pair.")
AnnotationAssertion(rdfs:label :AwsCredentialAuthentication "AWS Credential")
AnnotationAssertion(rdfs:label :AwsCredentialAuthentication "AWS Credential Authentication")
SubClassOf(:AwsCredentialAuthentication :AuthenticationScheme)

# Class: :BasicAuthentication (Basic Authentication)

AnnotationAssertion(obo:IAO_0000115 :BasicAuthentication "Authentication scheme that verifies identity by transmitting a username and password pair, typically Base64-encoded.")
AnnotationAssertion(rdfs:label :BasicAuthentication "Basic Authentication")
SubClassOf(:BasicAuthentication :AuthenticationScheme)

# Class: :BestEffort (Best Effort)

AnnotationAssertion(obo:IAO_0000115 :BestEffort "Service quality in which availability depends on upstream network and server conditions without formal guarantees.")
AnnotationAssertion(rdfs:comment :BestEffort "Quality depends on upstream server or network conditions.")
AnnotationAssertion(rdfs:label :BestEffort "Best Effort")
SubClassOf(:BestEffort :ServiceQuality)

# Class: :BitTorrentProtocol (BitTorrent)

AnnotationAssertion(obo:IAO_0000115 :BitTorrentProtocol "Protocol that distributes data across a swarm of peers using piece-based transfer and a distributed hash table for coordination.")
AnnotationAssertion(rdfs:label :BitTorrentProtocol "BitTorrent")
AnnotationAssertion(rdfs:label :BitTorrentProtocol "BitTorrent Protocol")
SubClassOf(:BitTorrentProtocol :Protocol)

# Class: :BulkDelivery (Bulk Delivery)

AnnotationAssertion(obo:IAO_0000115 :BulkDelivery "Delivery mode in which data is transferred as a complete unit within a single transaction.")
AnnotationAssertion(rdfs:label :BulkDelivery "Bulk Delivery")
SubClassOf(:BulkDelivery :DeliveryMode)

# Class: :CompleteCoverage (Complete)

AnnotationAssertion(obo:IAO_0000115 :CompleteCoverage "Coverage in which the distribution contains the entirety of the available data of its dataset.")
AnnotationAssertion(rdfs:label :CompleteCoverage "Complete")
AnnotationAssertion(rdfs:label :CompleteCoverage "Complete Coverage")
SubClassOf(:CompleteCoverage :Coverage)

# Class: :ContentAddressing (Content Addressing)

AnnotationAssertion(obo:IAO_0000115 :ContentAddressing "Verification method in which data is both identified and verified by a hash derived from its content, such that the identifier itself proves integrity.")
AnnotationAssertion(rdfs:comment :ContentAddressing "Content identified and verified by its hash, as in IPFS CIDs.")
AnnotationAssertion(rdfs:label :ContentAddressing "Content Addressing")
SubClassOf(:ContentAddressing :VerificationMethod)

# Class: :Coverage (Coverage)

AnnotationAssertion(obo:IAO_0000115 :Coverage "Characterisation of the extent to which a distribution represents the total available data of a dataset.")
AnnotationAssertion(rdfs:label :Coverage "Coverage")

# Class: :DeleteOperation (Delete)

AnnotationAssertion(obo:IAO_0000115 :DeleteOperation "Operation that permanently removes data from a data resource.")
AnnotationAssertion(rdfs:label :DeleteOperation "Delete")
AnnotationAssertion(rdfs:label :DeleteOperation "Delete Operation")
SubClassOf(:DeleteOperation :Operation)

# Class: :DeliveryMode (Delivery Mode)

AnnotationAssertion(obo:IAO_0000115 :DeliveryMode "Mechanism by which data is transferred from a data resource to a consuming agent.")
AnnotationAssertion(rdfs:label :DeliveryMode "Delivery Mode")

# Class: :DigitalSignature (Digital Signature)

AnnotationAssertion(obo:IAO_0000115 :DigitalSignature "Verification method that confirms both integrity and authenticity of data by validating a cryptographic signature produced by a known key holder.")
AnnotationAssertion(rdfs:comment :DigitalSignature "Integrity and authenticity verified via cryptographic signature.")
AnnotationAssertion(rdfs:label :DigitalSignature "Digital Signature")
SubClassOf(:DigitalSignature :VerificationMethod)

# Class: :Distributed (Distributed)

AnnotationAssertion(obo:IAO_0000115 :Distributed "Service quality in which data is replicated across multiple independent nodes for fault tolerance.")
AnnotationAssertion(rdfs:comment :Distributed "Data distributed across multiple peers or nodes.")
AnnotationAssertion(rdfs:label :Distributed "Distributed")
SubClassOf(:Distributed :ServiceQuality)

# Class: :EncryptionAlgorithm (Encryption Algorithm)

AnnotationAssertion(obo:IAO_0000115 :EncryptionAlgorithm "Cryptographic algorithm or protocol used to protect data confidentiality, either at rest or in transit.")
AnnotationAssertion(rdfs:label :EncryptionAlgorithm "Encryption Algorithm")

# Class: :EventDrivenDelivery (Event-Driven Delivery)

AnnotationAssertion(obo:IAO_0000115 :EventDrivenDelivery "Delivery mode in which data transfer is triggered by the occurrence of discrete events or state changes.")
AnnotationAssertion(rdfs:label :EventDrivenDelivery "Event-Driven Delivery")
SubClassOf(:EventDrivenDelivery :DeliveryMode)

# Class: :FtpProtocol (FTP)

AnnotationAssertion(obo:IAO_0000115 :FtpProtocol "Protocol that transfers files between client and server using the File Transfer Protocol.")
AnnotationAssertion(rdfs:label :FtpProtocol "FTP")
AnnotationAssertion(rdfs:label :FtpProtocol "FTP Protocol")
SubClassOf(:FtpProtocol :Protocol)

# Class: :GitProtocol (Git Protocol)

AnnotationAssertion(obo:IAO_0000115 :GitProtocol "Protocol that accesses version-controlled data through the Git distributed version control system.")
AnnotationAssertion(rdfs:label :GitProtocol "Git")
AnnotationAssertion(rdfs:label :GitProtocol "Git Protocol")
SubClassOf(:GitProtocol :Protocol)

# Class: :GpgEncryption (GPG Encryption)

AnnotationAssertion(obo:IAO_0000115 :GpgEncryption "Encryption using GNU Privacy Guard, an implementation of the OpenPGP standard.")
AnnotationAssertion(rdfs:comment :GpgEncryption "GNU Privacy Guard / OpenPGP encryption.")
AnnotationAssertion(rdfs:label :GpgEncryption "GPG Encryption")
SubClassOf(:GpgEncryption :EncryptionAlgorithm)

# Class: :GpgKeyAuthentication (GPG Key)

AnnotationAssertion(obo:IAO_0000115 :GpgKeyAuthentication "Authentication scheme that verifies identity and enables data signing using a GNU Privacy Guard key pair.")
AnnotationAssertion(rdfs:label :GpgKeyAuthentication "GPG Key")
AnnotationAssertion(rdfs:label :GpgKeyAuthentication "GPG Key Authentication")
SubClassOf(:GpgKeyAuthentication :AuthenticationScheme)

# Class: :HashVerification (Hash Verification)

AnnotationAssertion(obo:IAO_0000115 :HashVerification "Verification method that confirms data integrity by computing a cryptographic hash of the received content and comparing it against a known reference value.")
AnnotationAssertion(rdfs:comment :HashVerification "Integrity verified by comparing cryptographic hash of content.")
AnnotationAssertion(rdfs:label :HashVerification "Hash Verification")
SubClassOf(:HashVerification :VerificationMethod)

# Class: :HighAvailability (High Availability)

AnnotationAssertion(obo:IAO_0000115 :HighAvailability "Service quality in which the service is operated with infrastructure redundancy and contractual uptime guarantees.")
AnnotationAssertion(rdfs:comment :HighAvailability "Managed cloud services with SLA guarantees.")
AnnotationAssertion(rdfs:label :HighAvailability "High Availability")
SubClassOf(:HighAvailability :ServiceQuality)

# Class: :HookProtocol (Hook)

AnnotationAssertion(obo:IAO_0000115 :HookProtocol "Protocol that delegates data access operations to user-defined external scripts or commands.")
AnnotationAssertion(rdfs:comment :HookProtocol "Custom protocol via user-defined hook scripts.")
AnnotationAssertion(rdfs:label :HookProtocol "Hook")
AnnotationAssertion(rdfs:label :HookProtocol "Hook Protocol")
SubClassOf(:HookProtocol :Protocol)

# Class: :HttpProtocol (HTTP/HTTPS)

AnnotationAssertion(obo:IAO_0000115 :HttpProtocol "Protocol that transfers data using the Hypertext Transfer Protocol, optionally secured with Transport Layer Security.")
AnnotationAssertion(rdfs:label :HttpProtocol "HTTP Protocol")
AnnotationAssertion(rdfs:label :HttpProtocol "HTTP/HTTPS")
SubClassOf(:HttpProtocol :Protocol)

