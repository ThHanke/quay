Annotation(dcterms:description "A DCAT Profile for Data Access, Storage and Authorization Metadata.")
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:title "QUAY: Qualified Usage, Access and Yield")

