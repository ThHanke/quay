############################
#   Annotation Properties
############################

# Annotation Property: obo:IAO_0000115 (definition)

AnnotationAssertion(rdfs:label obo:IAO_0000115 "definition")

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (Title)

AnnotationAssertion(rdfs:label dcterms:title "title")


############################
#   Object Properties
############################

# Object Property: <https://w3id.org/quay/accessDescription> (access description)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/accessDescription> "Relates a distribution to a qualification node that describes how it is accessed.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/accessDescription> "access description")
ObjectPropertyDomain(<https://w3id.org/quay/accessDescription> dcat:Distribution)
ObjectPropertyRange(<https://w3id.org/quay/accessDescription> <https://w3id.org/quay/AccessDescription>)

# Object Property: <https://w3id.org/quay/authenticationScheme> (authentication scheme)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/authenticationScheme> "Relates an access description to the method used to verify the identity of the accessing agent.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/authenticationScheme> "authentication scheme")
ObjectPropertyDomain(<https://w3id.org/quay/authenticationScheme> <https://w3id.org/quay/AccessDescription>)
ObjectPropertyRange(<https://w3id.org/quay/authenticationScheme> <https://w3id.org/quay/AuthenticationScheme>)

# Object Property: <https://w3id.org/quay/coverage> (coverage)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/coverage> "Relates a yield description to the extent of dataset representation in the distribution.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/coverage> "coverage")
ObjectPropertyDomain(<https://w3id.org/quay/coverage> <https://w3id.org/quay/YieldDescription>)
ObjectPropertyRange(<https://w3id.org/quay/coverage> <https://w3id.org/quay/Coverage>)

# Object Property: <https://w3id.org/quay/deliveryMode> (delivery mode)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/deliveryMode> "Relates a yield description to the mechanism by which data is transferred to the consumer.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/deliveryMode> "delivery mode")
ObjectPropertyDomain(<https://w3id.org/quay/deliveryMode> <https://w3id.org/quay/YieldDescription>)
ObjectPropertyRange(<https://w3id.org/quay/deliveryMode> <https://w3id.org/quay/DeliveryMode>)

# Object Property: <https://w3id.org/quay/protocol> (protocol)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/protocol> "Relates an access description to the communication protocol used for data exchange.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/protocol> "protocol")
ObjectPropertyDomain(<https://w3id.org/quay/protocol> <https://w3id.org/quay/AccessDescription>)
ObjectPropertyRange(<https://w3id.org/quay/protocol> <https://w3id.org/quay/Protocol>)

# Object Property: <https://w3id.org/quay/serviceQuality> (service quality)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/serviceQuality> "Relates a yield description to the reliability and availability characterisation of the service.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/serviceQuality> "service quality")
ObjectPropertyDomain(<https://w3id.org/quay/serviceQuality> <https://w3id.org/quay/YieldDescription>)
ObjectPropertyRange(<https://w3id.org/quay/serviceQuality> <https://w3id.org/quay/ServiceQuality>)

# Object Property: <https://w3id.org/quay/supportedOperation> (supported operation)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/supportedOperation> "Relates an access description to an action that can be performed on the data resource.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/supportedOperation> "supported operation")
ObjectPropertyDomain(<https://w3id.org/quay/supportedOperation> <https://w3id.org/quay/AccessDescription>)
ObjectPropertyRange(<https://w3id.org/quay/supportedOperation> <https://w3id.org/quay/Operation>)

# Object Property: <https://w3id.org/quay/temporalQuality> (temporal quality)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/temporalQuality> "Relates a yield description to the freshness characterisation of the available data.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/temporalQuality> "temporal quality")
ObjectPropertyDomain(<https://w3id.org/quay/temporalQuality> <https://w3id.org/quay/YieldDescription>)
ObjectPropertyRange(<https://w3id.org/quay/temporalQuality> <https://w3id.org/quay/TemporalQuality>)

# Object Property: <https://w3id.org/quay/verificationMethod> (verification method)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/verificationMethod> "Relates a yield description to the mechanism used to verify data integrity after transfer.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/verificationMethod> "verification method")
ObjectPropertyDomain(<https://w3id.org/quay/verificationMethod> <https://w3id.org/quay/YieldDescription>)
ObjectPropertyRange(<https://w3id.org/quay/verificationMethod> <https://w3id.org/quay/VerificationMethod>)

# Object Property: <https://w3id.org/quay/yieldDescription> (yield description)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/yieldDescription> "Relates a distribution to a qualification node that describes what it delivers.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/yieldDescription> "yield description")
ObjectPropertyDomain(<https://w3id.org/quay/yieldDescription> dcat:Distribution)
ObjectPropertyRange(<https://w3id.org/quay/yieldDescription> <https://w3id.org/quay/YieldDescription>)


############################
#   Data Properties
############################

# Data Property: <https://w3id.org/quay/encryptionAtRest> (encryption at rest)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/encryptionAtRest> "Encryption algorithm applied to data at rest within the storage backend.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/encryptionAtRest> "encryption at rest")
DataPropertyDomain(<https://w3id.org/quay/encryptionAtRest> dcat:Distribution)
DataPropertyRange(<https://w3id.org/quay/encryptionAtRest> xsd:string)

# Data Property: <https://w3id.org/quay/encryptionInTransit> (encryption in transit)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/encryptionInTransit> "Encryption protocol applied to data during transfer between client and server.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/encryptionInTransit> "encryption in transit")
DataPropertyDomain(<https://w3id.org/quay/encryptionInTransit> dcat:Distribution)
DataPropertyRange(<https://w3id.org/quay/encryptionInTransit> xsd:string)



############################
#   Classes
############################

# Class: <https://w3id.org/quay/AccessDescription> (Access Description)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/AccessDescription> "Qualification node that specifies how a distribution is reached, comprising exactly one protocol, at least one authentication scheme, and at least one supported operation.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/AccessDescription> "Qualifies HOW a Distribution is reached.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/AccessDescription> "Access Description")
SubClassOf(<https://w3id.org/quay/AccessDescription> ObjectSomeValuesFrom(<https://w3id.org/quay/authenticationScheme> <https://w3id.org/quay/AuthenticationScheme>))
SubClassOf(<https://w3id.org/quay/AccessDescription> ObjectSomeValuesFrom(<https://w3id.org/quay/supportedOperation> <https://w3id.org/quay/Operation>))
SubClassOf(<https://w3id.org/quay/AccessDescription> ObjectExactCardinality(1 <https://w3id.org/quay/protocol> <https://w3id.org/quay/Protocol>))

# Class: <https://w3id.org/quay/ApiKeyAuthentication> (API Key)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/ApiKeyAuthentication> "Authentication scheme that verifies identity by presenting a pre-shared secret key with each request.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/ApiKeyAuthentication> "API Key")
SubClassOf(<https://w3id.org/quay/ApiKeyAuthentication> <https://w3id.org/quay/AuthenticationScheme>)

# Class: <https://w3id.org/quay/Archived> (Archived)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/Archived> "Temporal quality in which data is preserved for long-term retention and is no longer actively updated.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/Archived> "Archived")
SubClassOf(<https://w3id.org/quay/Archived> <https://w3id.org/quay/TemporalQuality>)

# Class: <https://w3id.org/quay/AuthenticationScheme> (Authentication Scheme)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/AuthenticationScheme> "Method used to verify the identity of an agent requesting access to a data resource.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/AuthenticationScheme> "Authentication Scheme")

# Class: <https://w3id.org/quay/AwsCredentialAuthentication> (AWS Credential)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/AwsCredentialAuthentication> "Authentication scheme that verifies identity using an AWS access key identifier and secret access key pair.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/AwsCredentialAuthentication> "AWS Credential")
SubClassOf(<https://w3id.org/quay/AwsCredentialAuthentication> <https://w3id.org/quay/AuthenticationScheme>)

# Class: <https://w3id.org/quay/BasicAuthentication> (Basic Authentication)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/BasicAuthentication> "Authentication scheme that verifies identity by transmitting a username and password pair, typically Base64-encoded.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/BasicAuthentication> "Basic Authentication")
SubClassOf(<https://w3id.org/quay/BasicAuthentication> <https://w3id.org/quay/AuthenticationScheme>)

# Class: <https://w3id.org/quay/BestEffort> (Best Effort)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/BestEffort> "Service quality in which availability depends on upstream network and server conditions without formal guarantees.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/BestEffort> "Quality depends on upstream server or network conditions.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/BestEffort> "Best Effort")
SubClassOf(<https://w3id.org/quay/BestEffort> <https://w3id.org/quay/ServiceQuality>)

# Class: <https://w3id.org/quay/BitTorrentProtocol> (BitTorrent)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/BitTorrentProtocol> "Protocol that distributes data across a swarm of peers using piece-based transfer and a distributed hash table for coordination.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/BitTorrentProtocol> "BitTorrent")
SubClassOf(<https://w3id.org/quay/BitTorrentProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/BulkDelivery> (Bulk Delivery)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/BulkDelivery> "Delivery mode in which data is transferred as a complete unit within a single transaction.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/BulkDelivery> "Bulk Delivery")
SubClassOf(<https://w3id.org/quay/BulkDelivery> <https://w3id.org/quay/DeliveryMode>)

# Class: <https://w3id.org/quay/CompleteCoverage> (Complete)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/CompleteCoverage> "Coverage in which the distribution contains the entirety of the available data of its dataset.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/CompleteCoverage> "Complete")
SubClassOf(<https://w3id.org/quay/CompleteCoverage> <https://w3id.org/quay/Coverage>)

# Class: <https://w3id.org/quay/ContentAddressing> (Content Addressing)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/ContentAddressing> "Verification method in which data is both identified and verified by a hash derived from its content, such that the identifier itself proves integrity.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/ContentAddressing> "Content identified and verified by its hash, as in IPFS CIDs.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/ContentAddressing> "Content Addressing")
SubClassOf(<https://w3id.org/quay/ContentAddressing> <https://w3id.org/quay/VerificationMethod>)

# Class: <https://w3id.org/quay/Coverage> (Coverage)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/Coverage> "Characterisation of the extent to which a distribution represents the total available data of a dataset.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/Coverage> "Coverage")

# Class: <https://w3id.org/quay/DeleteOperation> (Delete)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/DeleteOperation> "Operation that permanently removes data from a data resource.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/DeleteOperation> "Delete")
SubClassOf(<https://w3id.org/quay/DeleteOperation> <https://w3id.org/quay/Operation>)

# Class: <https://w3id.org/quay/DeliveryMode> (Delivery Mode)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/DeliveryMode> "Mechanism by which data is transferred from a data resource to a consuming agent.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/DeliveryMode> "Delivery Mode")

# Class: <https://w3id.org/quay/DigitalSignature> (Digital Signature)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/DigitalSignature> "Verification method that confirms both integrity and authenticity of data by validating a cryptographic signature produced by a known key holder.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/DigitalSignature> "Integrity and authenticity verified via cryptographic signature.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/DigitalSignature> "Digital Signature")
SubClassOf(<https://w3id.org/quay/DigitalSignature> <https://w3id.org/quay/VerificationMethod>)

# Class: <https://w3id.org/quay/Distributed> (Distributed)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/Distributed> "Service quality in which data is replicated across multiple independent nodes for fault tolerance.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/Distributed> "Data distributed across multiple peers or nodes.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/Distributed> "Distributed")
SubClassOf(<https://w3id.org/quay/Distributed> <https://w3id.org/quay/ServiceQuality>)

# Class: <https://w3id.org/quay/EventDrivenDelivery> (Event-Driven Delivery)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/EventDrivenDelivery> "Delivery mode in which data transfer is triggered by the occurrence of discrete events or state changes.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/EventDrivenDelivery> "Event-Driven Delivery")
SubClassOf(<https://w3id.org/quay/EventDrivenDelivery> <https://w3id.org/quay/DeliveryMode>)

# Class: <https://w3id.org/quay/FtpProtocol> (FTP)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/FtpProtocol> "Protocol that transfers files between client and server using the File Transfer Protocol.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/FtpProtocol> "FTP")
SubClassOf(<https://w3id.org/quay/FtpProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/GitProtocol> (Git)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/GitProtocol> "Protocol that accesses version-controlled data through the Git distributed version control system.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/GitProtocol> "Git")
SubClassOf(<https://w3id.org/quay/GitProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/GpgKeyAuthentication> (GPG Key)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/GpgKeyAuthentication> "Authentication scheme that verifies identity and enables data signing using a GNU Privacy Guard key pair.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/GpgKeyAuthentication> "GPG Key")
SubClassOf(<https://w3id.org/quay/GpgKeyAuthentication> <https://w3id.org/quay/AuthenticationScheme>)

# Class: <https://w3id.org/quay/HashVerification> (Hash Verification)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/HashVerification> "Verification method that confirms data integrity by computing a cryptographic hash of the received content and comparing it against a known reference value.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/HashVerification> "Integrity verified by comparing cryptographic hash of content.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/HashVerification> "Hash Verification")
SubClassOf(<https://w3id.org/quay/HashVerification> <https://w3id.org/quay/VerificationMethod>)

# Class: <https://w3id.org/quay/HighAvailability> (High Availability)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/HighAvailability> "Service quality in which the service is operated with infrastructure redundancy and contractual uptime guarantees.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/HighAvailability> "Managed cloud services with SLA guarantees.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/HighAvailability> "High Availability")
SubClassOf(<https://w3id.org/quay/HighAvailability> <https://w3id.org/quay/ServiceQuality>)

# Class: <https://w3id.org/quay/HookProtocol> (Hook)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/HookProtocol> "Protocol that delegates data access operations to user-defined external scripts or commands.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/HookProtocol> "Custom protocol via user-defined hook scripts.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/HookProtocol> "Hook")
SubClassOf(<https://w3id.org/quay/HookProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/HttpProtocol> (HTTP/HTTPS)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/HttpProtocol> "Protocol that transfers data using the Hypertext Transfer Protocol, optionally secured with Transport Layer Security.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/HttpProtocol> "HTTP/HTTPS")
SubClassOf(<https://w3id.org/quay/HttpProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/IncrementalCoverage> (Incremental)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/IncrementalCoverage> "Coverage in which the distribution contains only changes accumulated since a specified reference point.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/IncrementalCoverage> "Incremental")
SubClassOf(<https://w3id.org/quay/IncrementalCoverage> <https://w3id.org/quay/Coverage>)

# Class: <https://w3id.org/quay/IpfsProtocol> (IPFS)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/IpfsProtocol> "Protocol that addresses and retrieves data by cryptographic content identifier on the InterPlanetary File System network.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/IpfsProtocol> "IPFS")
SubClassOf(<https://w3id.org/quay/IpfsProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/ListOperation> (List)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/ListOperation> "Operation that enumerates the available entries or contents of a data resource.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/ListOperation> "List")
SubClassOf(<https://w3id.org/quay/ListOperation> <https://w3id.org/quay/Operation>)

# Class: <https://w3id.org/quay/LocalFilesystemProtocol> (Local Filesystem)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/LocalFilesystemProtocol> "Protocol that accesses data directly through the operating system local filesystem interface without network transfer.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/LocalFilesystemProtocol> "Local Filesystem")
SubClassOf(<https://w3id.org/quay/LocalFilesystemProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/NoAuthentication> (No Authentication)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/NoAuthentication> "Authentication scheme that permits access without requiring identity verification.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/NoAuthentication> "No Authentication")
SubClassOf(<https://w3id.org/quay/NoAuthentication> <https://w3id.org/quay/AuthenticationScheme>)

# Class: <https://w3id.org/quay/NoVerification> (No Verification)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/NoVerification> "Verification method designation indicating that no integrity or authenticity verification mechanism is applied.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/NoVerification> "No integrity verification mechanism available.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/NoVerification> "No Verification")
SubClassOf(<https://w3id.org/quay/NoVerification> <https://w3id.org/quay/VerificationMethod>)

# Class: <https://w3id.org/quay/OAuth2Authentication> (OAuth 2.0)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/OAuth2Authentication> "Authentication scheme that verifies identity through the OAuth 2.0 authorization framework using token-based delegated access.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/OAuth2Authentication> "OAuth 2.0")
SubClassOf(<https://w3id.org/quay/OAuth2Authentication> <https://w3id.org/quay/AuthenticationScheme>)

# Class: <https://w3id.org/quay/Operation> (Operation)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/Operation> "Action that can be performed on a data resource through an access point.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/Operation> "Operation")

# Class: <https://w3id.org/quay/PaginatedDelivery> (Paginated Delivery)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/PaginatedDelivery> "Delivery mode in which data is transferred in discrete, sequentially ordered pages of bounded size.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/PaginatedDelivery> "Paginated Delivery")
SubClassOf(<https://w3id.org/quay/PaginatedDelivery> <https://w3id.org/quay/DeliveryMode>)

# Class: <https://w3id.org/quay/PeerToPeerDelivery> (Peer-to-Peer Delivery)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/PeerToPeerDelivery> "Delivery mode in which data is transferred directly between participating peers without routing through a central server.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/PeerToPeerDelivery> "Peer-to-Peer Delivery")
SubClassOf(<https://w3id.org/quay/PeerToPeerDelivery> <https://w3id.org/quay/DeliveryMode>)

# Class: <https://w3id.org/quay/PieceVerification> (Piece Verification)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/PieceVerification> "Verification method that confirms integrity of individual data segments by validating each against a Merkle hash tree.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/PieceVerification> "Integrity verified per-piece using a hash tree, as in BitTorrent.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/PieceVerification> "Piece Verification")
SubClassOf(<https://w3id.org/quay/PieceVerification> <https://w3id.org/quay/VerificationMethod>)

# Class: <https://w3id.org/quay/Protocol> (Protocol)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/Protocol> "Communication method that governs the rules and format of data exchange between a client and a data resource.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/Protocol> "Protocol")

# Class: <https://w3id.org/quay/RcloneProtocol> (Rclone)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/RcloneProtocol> "Protocol that delegates data access to the rclone tool, which abstracts over multiple cloud storage backends.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/RcloneProtocol> "Rclone")
SubClassOf(<https://w3id.org/quay/RcloneProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/ReadOperation> (Read)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/ReadOperation> "Operation that retrieves data from a data resource without modifying it.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/ReadOperation> "Read")
SubClassOf(<https://w3id.org/quay/ReadOperation> <https://w3id.org/quay/Operation>)

# Class: <https://w3id.org/quay/RealTime> (Real-Time)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/RealTime> "Temporal quality in which data reflects the current state of its source with minimal latency.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/RealTime> "Real-Time")
SubClassOf(<https://w3id.org/quay/RealTime> <https://w3id.org/quay/TemporalQuality>)

