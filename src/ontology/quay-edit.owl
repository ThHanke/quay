# Class: :Operation (Operation)

AnnotationAssertion(obo:IAO_0000115 :Operation "Action that can be performed on a data resource through an access point.")
AnnotationAssertion(rdfs:label :Operation "Operation")
SubClassOf(:Operation odrl:Action)

# Class: :PaginatedDelivery (Paginated Delivery)

AnnotationAssertion(obo:IAO_0000115 :PaginatedDelivery "Delivery mode in which data is transferred in discrete, sequentially ordered pages of bounded size.")
AnnotationAssertion(rdfs:label :PaginatedDelivery "Paginated Delivery")
