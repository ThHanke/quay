Prefix(:=<https://w3id.org/quay.owl#>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(dcat:=<http://www.w3.org/ns/dcat#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(spdx:=<http://spdx.org/rdf/terms#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<https://w3id.org/quay.owl>
Import(<https://w3id.org/quay/imports/dcat_import.owl>)
Import(<https://w3id.org/quay/imports/odrl_import.owl>)
Annotation(dcterms:description "A DCAT Profile for Data Access, Storage and Authorization Metadata.")
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:title "QUAY: Qualified Usage, Access and Yield")

############################
