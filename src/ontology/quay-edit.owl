AnnotationAssertion(obo:IAO_0000115 :IncrementalCoverage "Coverage in which the distribution contains only changes accumulated since a specified reference point.")
AnnotationAssertion(rdfs:label :IncrementalCoverage "Incremental")
AnnotationAssertion(rdfs:label :IncrementalCoverage "Incremental Coverage")
