AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/SynchronousDelivery> "Delivery mode in which data is transferred within a blocking request-response cycle that completes before control returns to the caller.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/SynchronousDelivery> "Synchronous Delivery")
SubClassOf(<https://w3id.org/quay/SynchronousDelivery> <https://w3id.org/quay/DeliveryMode>)

# Class: <https://w3id.org/quay/TemporalQuality> (Temporal Quality)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/TemporalQuality> "Characterisation of the freshness and currency of data available from a distribution.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/TemporalQuality> "Temporal Quality")

# Class: <https://w3id.org/quay/VerificationMethod> (Verification Method)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/VerificationMethod> "Mechanism used to confirm the integrity or authenticity of data after transfer.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/VerificationMethod> "Verification Method")

# Class: <https://w3id.org/quay/Versioned> (Versioned)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/Versioned> "Temporal quality in which data is maintained as a sequence of immutable, individually identifiable revisions.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/Versioned> "Versioned")
SubClassOf(<https://w3id.org/quay/Versioned> <https://w3id.org/quay/TemporalQuality>)

# Class: <https://w3id.org/quay/WebDavProtocol> (WebDAV)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/WebDavProtocol> "Protocol that extends HTTP with distributed authoring and versioning capabilities for remote file management.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/WebDavProtocol> "WebDAV")
SubClassOf(<https://w3id.org/quay/WebDavProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/WriteOperation> (Write)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/WriteOperation> "Operation that stores new data in or modifies existing data within a data resource.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/WriteOperation> "Write")
SubClassOf(<https://w3id.org/quay/WriteOperation> <https://w3id.org/quay/Operation>)

# Class: <https://w3id.org/quay/YieldDescription> (Yield Description)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/YieldDescription> "Qualification node that specifies what a distribution delivers, comprising exactly one delivery mode and optional temporal quality, coverage, service quality, and verification method descriptors.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/YieldDescription> "Qualifies WHAT a Distribution delivers.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/YieldDescription> "Yield Description")
SubClassOf(<https://w3id.org/quay/YieldDescription> ObjectExactCardinality(1 <https://w3id.org/quay/deliveryMode> <https://w3id.org/quay/DeliveryMode>))
SubClassOf(<https://w3id.org/quay/YieldDescription> ObjectMaxCardinality(1 <https://w3id.org/quay/coverage> <https://w3id.org/quay/Coverage>))
SubClassOf(<https://w3id.org/quay/YieldDescription> ObjectMaxCardinality(1 <https://w3id.org/quay/temporalQuality> <https://w3id.org/quay/TemporalQuality>))



