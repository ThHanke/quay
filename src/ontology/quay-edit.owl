AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/RsyncProtocol> "Protocol that synchronises files between locations using the rsync delta-transfer algorithm.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/RsyncProtocol> "Rsync")
SubClassOf(<https://w3id.org/quay/RsyncProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/S3Protocol> (S3)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/S3Protocol> "Protocol that accesses object storage using the Amazon Simple Storage Service API.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/S3Protocol> "S3")
SubClassOf(<https://w3id.org/quay/S3Protocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/SampleCoverage> (Sample)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/SampleCoverage> "Coverage in which the distribution contains a statistically representative fraction of the available data.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/SampleCoverage> "Sample")
SubClassOf(<https://w3id.org/quay/SampleCoverage> <https://w3id.org/quay/Coverage>)

# Class: <https://w3id.org/quay/ServiceQuality> (Service Quality)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/ServiceQuality> "Characterisation of the reliability, availability, and redundancy properties of a data access service.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/ServiceQuality> "Service Quality")

# Class: <https://w3id.org/quay/SingleHost> (Single Host)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/SingleHost> "Service quality in which data resides on a single machine with no infrastructure redundancy.")
AnnotationAssertion(rdfs:comment <https://w3id.org/quay/SingleHost> "Data resides on a single machine with no redundancy.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/SingleHost> "Single Host")
SubClassOf(<https://w3id.org/quay/SingleHost> <https://w3id.org/quay/ServiceQuality>)

# Class: <https://w3id.org/quay/Snapshot> (Snapshot)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/Snapshot> "Temporal quality in which data represents a consistent state captured at a specific point in time.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/Snapshot> "Snapshot")
SubClassOf(<https://w3id.org/quay/Snapshot> <https://w3id.org/quay/TemporalQuality>)

