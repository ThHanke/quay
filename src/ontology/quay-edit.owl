AnnotationAssertion(rdfs:label :NoAuthentication "No Authentication")
SubClassOf(:NoAuthentication :AuthenticationScheme)

# Class: :NoEncryption (No Encryption)

AnnotationAssertion(obo:IAO_0000115 :NoEncryption "Designation indicating that no encryption is applied to the data.")
AnnotationAssertion(rdfs:comment :NoEncryption "No encryption applied.")
AnnotationAssertion(rdfs:label :NoEncryption "No Encryption")
SubClassOf(:NoEncryption :EncryptionAlgorithm)

# Class: :NoVerification (No Verification)

AnnotationAssertion(obo:IAO_0000115 :NoVerification "Verification method designation indicating that no integrity or authenticity verification mechanism is applied.")
AnnotationAssertion(rdfs:comment :NoVerification "No integrity verification mechanism available.")
AnnotationAssertion(rdfs:label :NoVerification "No Verification")
SubClassOf(:NoVerification :VerificationMethod)

# Class: :OAuth2Authentication (OAuth 2.0)

AnnotationAssertion(obo:IAO_0000115 :OAuth2Authentication "Authentication scheme that verifies identity through the OAuth 2.0 authorization framework using token-based delegated access.")
