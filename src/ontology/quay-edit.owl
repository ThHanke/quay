AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/ReplicateOperation> "Operation that copies data from one data resource to another for redundancy or distribution.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/ReplicateOperation> "Replicate")
SubClassOf(<https://w3id.org/quay/ReplicateOperation> <https://w3id.org/quay/Operation>)

