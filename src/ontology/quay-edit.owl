############################
#   Restriction Axioms
############################

# AccessDescription: exactly 1 protocol
SubClassOf(:QUAY_0000001 ObjectExactCardinality(1 :QUAY_0000048 :QUAY_0000003))

# AccessDescription: at least 1 authentication scheme
SubClassOf(:QUAY_0000001 ObjectSomeValuesFrom(:QUAY_0000049 :QUAY_0000015))

# AccessDescription: at least 1 supported operation
SubClassOf(:QUAY_0000001 ObjectSomeValuesFrom(:QUAY_0000050 :QUAY_0000028))

# YieldDescription: exactly 1 delivery mode
SubClassOf(:QUAY_0000002 ObjectExactCardinality(1 :QUAY_0000051 :QUAY_0000029))

# YieldDescription: at most 1 temporal quality
SubClassOf(:QUAY_0000002 ObjectMaxCardinality(1 :QUAY_0000052 :QUAY_0000034))

# YieldDescription: at most 1 coverage
SubClassOf(:QUAY_0000002 ObjectMaxCardinality(1 :QUAY_0000053 :QUAY_0000039))


