AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/SshKeyAuthentication> "Authentication scheme that verifies identity using an asymmetric SSH key pair.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/SshKeyAuthentication> "SSH Key")
SubClassOf(<https://w3id.org/quay/SshKeyAuthentication> <https://w3id.org/quay/AuthenticationScheme>)

