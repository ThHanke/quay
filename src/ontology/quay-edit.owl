# Class: :PeerToPeerDelivery (Peer-to-Peer Delivery)

AnnotationAssertion(obo:IAO_0000115 :PeerToPeerDelivery "Delivery mode in which data is transferred directly between participating peers without routing through a central server.")
AnnotationAssertion(rdfs:label :PeerToPeerDelivery "Peer-to-Peer Delivery")
SubClassOf(:PeerToPeerDelivery :DeliveryMode)

# Class: :PieceVerification (Piece Verification)

AnnotationAssertion(obo:IAO_0000115 :PieceVerification "Verification method that confirms integrity of individual data segments by validating each against a Merkle hash tree.")
AnnotationAssertion(rdfs:comment :PieceVerification "Integrity verified per-piece using a hash tree, as in BitTorrent.")
AnnotationAssertion(rdfs:label :PieceVerification "Piece Verification")
SubClassOf(:PieceVerification :VerificationMethod)

# Class: :Protocol (Protocol)

AnnotationAssertion(obo:IAO_0000115 :Protocol "Communication method that governs the rules and format of data exchange between a client and a data resource.")
AnnotationAssertion(rdfs:label :Protocol "Protocol")

# Class: :RcloneProtocol (Rclone)

AnnotationAssertion(obo:IAO_0000115 :RcloneProtocol "Protocol that delegates data access to the rclone tool, which abstracts over multiple cloud storage backends.")
