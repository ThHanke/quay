############################
#   Definitions (IAO:0000115)
############################

# Core Qualification Classes
AnnotationAssertion(obo:IAO_0000115 :AccessDescription "Qualification node that specifies how a distribution is reached, comprising exactly one protocol, at least one authentication scheme, and at least one supported operation.")
AnnotationAssertion(obo:IAO_0000115 :YieldDescription "Qualification node that specifies what a distribution delivers, comprising exactly one delivery mode and optional temporal quality, coverage, service quality, and verification method descriptors.")

# Protocol hierarchy
AnnotationAssertion(obo:IAO_0000115 :Protocol "Communication method that governs the rules and format of data exchange between a client and a data resource.")
AnnotationAssertion(obo:IAO_0000115 :HttpProtocol "Protocol that transfers data using the Hypertext Transfer Protocol, optionally secured with Transport Layer Security.")
AnnotationAssertion(obo:IAO_0000115 :S3Protocol "Protocol that accesses object storage using the Amazon Simple Storage Service API.")
AnnotationAssertion(obo:IAO_0000115 :RsyncProtocol "Protocol that synchronises files between locations using the rsync delta-transfer algorithm.")
AnnotationAssertion(obo:IAO_0000115 :WebDavProtocol "Protocol that extends HTTP with distributed authoring and versioning capabilities for remote file management.")
AnnotationAssertion(obo:IAO_0000115 :SshProtocol "Protocol that provides encrypted file transfer and remote command execution over a Secure Shell connection.")
AnnotationAssertion(obo:IAO_0000115 :BitTorrentProtocol "Protocol that distributes data across a swarm of peers using piece-based transfer and a distributed hash table for coordination.")
AnnotationAssertion(obo:IAO_0000115 :IpfsProtocol "Protocol that addresses and retrieves data by cryptographic content identifier on the InterPlanetary File System network.")
AnnotationAssertion(obo:IAO_0000115 :LocalFilesystemProtocol "Protocol that accesses data directly through the operating system local filesystem interface without network transfer.")
AnnotationAssertion(obo:IAO_0000115 :RcloneProtocol "Protocol that delegates data access to the rclone tool, which abstracts over multiple cloud storage backends.")
AnnotationAssertion(obo:IAO_0000115 :FtpProtocol "Protocol that transfers files between client and server using the File Transfer Protocol.")
AnnotationAssertion(obo:IAO_0000115 :GitProtocol "Protocol that accesses version-controlled data through the Git distributed version control system.")
AnnotationAssertion(obo:IAO_0000115 :HookProtocol "Protocol that delegates data access operations to user-defined external scripts or commands.")

# Authentication Scheme hierarchy
AnnotationAssertion(obo:IAO_0000115 :AuthenticationScheme "Method used to verify the identity of an agent requesting access to a data resource.")
AnnotationAssertion(obo:IAO_0000115 :NoAuthentication "Authentication scheme that permits access without requiring identity verification.")
AnnotationAssertion(obo:IAO_0000115 :ApiKeyAuthentication "Authentication scheme that verifies identity by presenting a pre-shared secret key with each request.")
AnnotationAssertion(obo:IAO_0000115 :OAuth2Authentication "Authentication scheme that verifies identity through the OAuth 2.0 authorization framework using token-based delegated access.")
AnnotationAssertion(obo:IAO_0000115 :BasicAuthentication "Authentication scheme that verifies identity by transmitting a username and password pair, typically Base64-encoded.")
AnnotationAssertion(obo:IAO_0000115 :SshKeyAuthentication "Authentication scheme that verifies identity using an asymmetric SSH key pair.")
AnnotationAssertion(obo:IAO_0000115 :GpgKeyAuthentication "Authentication scheme that verifies identity and enables data signing using a GNU Privacy Guard key pair.")
AnnotationAssertion(obo:IAO_0000115 :AwsCredentialAuthentication "Authentication scheme that verifies identity using an AWS access key identifier and secret access key pair.")

# Operation hierarchy
AnnotationAssertion(obo:IAO_0000115 :Operation "Action that can be performed on a data resource through an access point.")
AnnotationAssertion(obo:IAO_0000115 :ReadOperation "Operation that retrieves data from a data resource without modifying it.")
AnnotationAssertion(obo:IAO_0000115 :WriteOperation "Operation that stores new data in or modifies existing data within a data resource.")
AnnotationAssertion(obo:IAO_0000115 :DeleteOperation "Operation that permanently removes data from a data resource.")
AnnotationAssertion(obo:IAO_0000115 :ListOperation "Operation that enumerates the available entries or contents of a data resource.")
AnnotationAssertion(obo:IAO_0000115 :ReplicateOperation "Operation that copies data from one data resource to another for redundancy or distribution.")

# Delivery Mode hierarchy
AnnotationAssertion(obo:IAO_0000115 :DeliveryMode "Mechanism by which data is transferred from a data resource to a consuming agent.")
AnnotationAssertion(obo:IAO_0000115 :BulkDelivery "Delivery mode in which data is transferred as a complete unit within a single transaction.")
AnnotationAssertion(obo:IAO_0000115 :StreamingDelivery "Delivery mode in which data is transferred as a continuous flow of incremental units over a persistent connection.")
AnnotationAssertion(obo:IAO_0000115 :PaginatedDelivery "Delivery mode in which data is transferred in discrete, sequentially ordered pages of bounded size.")
AnnotationAssertion(obo:IAO_0000115 :EventDrivenDelivery "Delivery mode in which data transfer is triggered by the occurrence of discrete events or state changes.")
AnnotationAssertion(obo:IAO_0000115 :SynchronousDelivery "Delivery mode in which data is transferred within a blocking request-response cycle that completes before control returns to the caller.")
AnnotationAssertion(obo:IAO_0000115 :PeerToPeerDelivery "Delivery mode in which data is transferred directly between participating peers without routing through a central server.")

# Temporal Quality hierarchy
AnnotationAssertion(obo:IAO_0000115 :TemporalQuality "Characterisation of the freshness and currency of data available from a distribution.")
AnnotationAssertion(obo:IAO_0000115 :RealTime "Temporal quality in which data reflects the current state of its source with minimal latency.")
AnnotationAssertion(obo:IAO_0000115 :Snapshot "Temporal quality in which data represents a consistent state captured at a specific point in time.")
AnnotationAssertion(obo:IAO_0000115 :Archived "Temporal quality in which data is preserved for long-term retention and is no longer actively updated.")
AnnotationAssertion(obo:IAO_0000115 :Versioned "Temporal quality in which data is maintained as a sequence of immutable, individually identifiable revisions.")

# Coverage hierarchy
AnnotationAssertion(obo:IAO_0000115 :Coverage "Characterisation of the extent to which a distribution represents the total available data of a dataset.")
AnnotationAssertion(obo:IAO_0000115 :CompleteCoverage "Coverage in which the distribution contains the entirety of the available data of its dataset.")
AnnotationAssertion(obo:IAO_0000115 :SubsetCoverage "Coverage in which the distribution contains a defined, criteria-based portion of the available data.")
AnnotationAssertion(obo:IAO_0000115 :SampleCoverage "Coverage in which the distribution contains a statistically representative fraction of the available data.")
AnnotationAssertion(obo:IAO_0000115 :IncrementalCoverage "Coverage in which the distribution contains only changes accumulated since a specified reference point.")

# Service Quality hierarchy
AnnotationAssertion(obo:IAO_0000115 :ServiceQuality "Characterisation of the reliability, availability, and redundancy properties of a data access service.")
AnnotationAssertion(obo:IAO_0000115 :HighAvailability "Service quality in which the service is operated with infrastructure redundancy and contractual uptime guarantees.")
AnnotationAssertion(obo:IAO_0000115 :BestEffort "Service quality in which availability depends on upstream network and server conditions without formal guarantees.")
AnnotationAssertion(obo:IAO_0000115 :SingleHost "Service quality in which data resides on a single machine with no infrastructure redundancy.")
AnnotationAssertion(obo:IAO_0000115 :Distributed "Service quality in which data is replicated across multiple independent nodes for fault tolerance.")

# Verification Method hierarchy
AnnotationAssertion(obo:IAO_0000115 :VerificationMethod "Mechanism used to confirm the integrity or authenticity of data after transfer.")
AnnotationAssertion(obo:IAO_0000115 :HashVerification "Verification method that confirms data integrity by computing a cryptographic hash of the received content and comparing it against a known reference value.")
AnnotationAssertion(obo:IAO_0000115 :ContentAddressing "Verification method in which data is both identified and verified by a hash derived from its content, such that the identifier itself proves integrity.")
AnnotationAssertion(obo:IAO_0000115 :PieceVerification "Verification method that confirms integrity of individual data segments by validating each against a Merkle hash tree.")
AnnotationAssertion(obo:IAO_0000115 :DigitalSignature "Verification method that confirms both integrity and authenticity of data by validating a cryptographic signature produced by a known key holder.")
AnnotationAssertion(obo:IAO_0000115 :NoVerification "Verification method designation indicating that no integrity or authenticity verification mechanism is applied.")

# Object Properties
AnnotationAssertion(obo:IAO_0000115 :accessDescription "Relates a distribution to a qualification node that describes how it is accessed.")
AnnotationAssertion(obo:IAO_0000115 :yieldDescription "Relates a distribution to a qualification node that describes what it delivers.")
AnnotationAssertion(obo:IAO_0000115 :protocol "Relates an access description to the communication protocol used for data exchange.")
AnnotationAssertion(obo:IAO_0000115 :authenticationScheme "Relates an access description to the method used to verify the identity of the accessing agent.")
AnnotationAssertion(obo:IAO_0000115 :supportedOperation "Relates an access description to an action that can be performed on the data resource.")
AnnotationAssertion(obo:IAO_0000115 :deliveryMode "Relates a yield description to the mechanism by which data is transferred to the consumer.")
AnnotationAssertion(obo:IAO_0000115 :temporalQuality "Relates a yield description to the freshness characterisation of the available data.")
AnnotationAssertion(obo:IAO_0000115 :coverage "Relates a yield description to the extent of dataset representation in the distribution.")
AnnotationAssertion(obo:IAO_0000115 :serviceQuality "Relates a yield description to the reliability and availability characterisation of the service.")
AnnotationAssertion(obo:IAO_0000115 :verificationMethod "Relates a yield description to the mechanism used to verify data integrity after transfer.")

# Datatype Properties
AnnotationAssertion(obo:IAO_0000115 :encryptionAtRest "Encryption algorithm applied to data at rest within the storage backend.")
AnnotationAssertion(obo:IAO_0000115 :encryptionInTransit "Encryption protocol applied to data during transfer between client and server.")

############################
#   Object Properties — Annotations, Domain, Range
############################

AnnotationAssertion(rdfs:label :accessDescription "access description")
ObjectPropertyDomain(:accessDescription dcat:Distribution)
ObjectPropertyRange(:accessDescription :AccessDescription)

AnnotationAssertion(rdfs:label :yieldDescription "yield description")
ObjectPropertyDomain(:yieldDescription dcat:Distribution)
ObjectPropertyRange(:yieldDescription :YieldDescription)

AnnotationAssertion(rdfs:label :protocol "protocol")
ObjectPropertyDomain(:protocol :AccessDescription)
ObjectPropertyRange(:protocol :Protocol)

AnnotationAssertion(rdfs:label :authenticationScheme "authentication scheme")
ObjectPropertyDomain(:authenticationScheme :AccessDescription)
ObjectPropertyRange(:authenticationScheme :AuthenticationScheme)

AnnotationAssertion(rdfs:label :supportedOperation "supported operation")
ObjectPropertyDomain(:supportedOperation :AccessDescription)
ObjectPropertyRange(:supportedOperation :Operation)

AnnotationAssertion(rdfs:label :deliveryMode "delivery mode")
ObjectPropertyDomain(:deliveryMode :YieldDescription)
ObjectPropertyRange(:deliveryMode :DeliveryMode)

AnnotationAssertion(rdfs:label :temporalQuality "temporal quality")
ObjectPropertyDomain(:temporalQuality :YieldDescription)
ObjectPropertyRange(:temporalQuality :TemporalQuality)

AnnotationAssertion(rdfs:label :coverage "coverage")
ObjectPropertyDomain(:coverage :YieldDescription)
ObjectPropertyRange(:coverage :Coverage)

AnnotationAssertion(rdfs:label :serviceQuality "service quality")
ObjectPropertyDomain(:serviceQuality :YieldDescription)
ObjectPropertyRange(:serviceQuality :ServiceQuality)

AnnotationAssertion(rdfs:label :verificationMethod "verification method")
ObjectPropertyDomain(:verificationMethod :YieldDescription)
ObjectPropertyRange(:verificationMethod :VerificationMethod)

############################
#   Datatype Properties — Annotations, Domain, Range
############################

AnnotationAssertion(rdfs:label :encryptionAtRest "encryption at rest")
DataPropertyDomain(:encryptionAtRest dcat:Distribution)
DataPropertyRange(:encryptionAtRest xsd:string)

AnnotationAssertion(rdfs:label :encryptionInTransit "encryption in transit")
DataPropertyDomain(:encryptionInTransit dcat:Distribution)
DataPropertyRange(:encryptionInTransit xsd:string)


############################
#   Subclass Axioms
############################

# Protocol hierarchy
SubClassOf(:HttpProtocol :Protocol)
SubClassOf(:S3Protocol :Protocol)
SubClassOf(:RsyncProtocol :Protocol)
SubClassOf(:WebDavProtocol :Protocol)
SubClassOf(:SshProtocol :Protocol)
SubClassOf(:BitTorrentProtocol :Protocol)
SubClassOf(:IpfsProtocol :Protocol)
SubClassOf(:LocalFilesystemProtocol :Protocol)
SubClassOf(:RcloneProtocol :Protocol)
SubClassOf(:FtpProtocol :Protocol)
SubClassOf(:GitProtocol :Protocol)

# AuthScheme hierarchy
SubClassOf(:NoAuthentication :AuthenticationScheme)
SubClassOf(:ApiKeyAuthentication :AuthenticationScheme)
SubClassOf(:OAuth2Authentication :AuthenticationScheme)
SubClassOf(:BasicAuthentication :AuthenticationScheme)
SubClassOf(:SshKeyAuthentication :AuthenticationScheme)
SubClassOf(:GpgKeyAuthentication :AuthenticationScheme)
SubClassOf(:AwsCredentialAuthentication :AuthenticationScheme)

# Operation hierarchy
SubClassOf(:ReadOperation :Operation)
SubClassOf(:WriteOperation :Operation)
SubClassOf(:DeleteOperation :Operation)
SubClassOf(:ListOperation :Operation)
SubClassOf(:ReplicateOperation :Operation)

# DeliveryMode hierarchy
SubClassOf(:BulkDelivery :DeliveryMode)
SubClassOf(:StreamingDelivery :DeliveryMode)
SubClassOf(:PaginatedDelivery :DeliveryMode)
SubClassOf(:EventDrivenDelivery :DeliveryMode)

# TemporalQuality hierarchy
SubClassOf(:RealTime :TemporalQuality)
SubClassOf(:Snapshot :TemporalQuality)
SubClassOf(:Archived :TemporalQuality)
SubClassOf(:Versioned :TemporalQuality)

# Coverage hierarchy
SubClassOf(:CompleteCoverage :Coverage)
SubClassOf(:SubsetCoverage :Coverage)
SubClassOf(:SampleCoverage :Coverage)
SubClassOf(:IncrementalCoverage :Coverage)

# DeliveryMode additions
SubClassOf(:SynchronousDelivery :DeliveryMode)
SubClassOf(:PeerToPeerDelivery :DeliveryMode)

# ServiceQuality hierarchy
SubClassOf(:HighAvailability :ServiceQuality)
SubClassOf(:BestEffort :ServiceQuality)
SubClassOf(:SingleHost :ServiceQuality)
SubClassOf(:Distributed :ServiceQuality)

# VerificationMethod hierarchy
SubClassOf(:HashVerification :VerificationMethod)
SubClassOf(:ContentAddressing :VerificationMethod)
SubClassOf(:PieceVerification :VerificationMethod)
SubClassOf(:DigitalSignature :VerificationMethod)
SubClassOf(:NoVerification :VerificationMethod)

# Protocol addition
SubClassOf(:HookProtocol :Protocol)

############################
#   Disjointness Axioms
############################

# Top-level category classes
DisjointClasses(:AccessDescription :YieldDescription :Protocol :AuthenticationScheme :Operation :DeliveryMode :TemporalQuality :Coverage :ServiceQuality :VerificationMethod)

# Protocol subclasses
DisjointClasses(:HttpProtocol :S3Protocol :RsyncProtocol :WebDavProtocol :SshProtocol :BitTorrentProtocol :IpfsProtocol :LocalFilesystemProtocol :RcloneProtocol :FtpProtocol :GitProtocol :HookProtocol)

# AuthScheme subclasses
DisjointClasses(:NoAuthentication :ApiKeyAuthentication :OAuth2Authentication :BasicAuthentication :SshKeyAuthentication :GpgKeyAuthentication :AwsCredentialAuthentication)

# Operation subclasses
DisjointClasses(:ReadOperation :WriteOperation :DeleteOperation :ListOperation :ReplicateOperation)

# DeliveryMode subclasses
DisjointClasses(:BulkDelivery :StreamingDelivery :PaginatedDelivery :EventDrivenDelivery :SynchronousDelivery :PeerToPeerDelivery)

# TemporalQuality subclasses
DisjointClasses(:RealTime :Snapshot :Archived :Versioned)

# Coverage subclasses
DisjointClasses(:CompleteCoverage :SubsetCoverage :SampleCoverage :IncrementalCoverage)

# ServiceQuality subclasses
DisjointClasses(:HighAvailability :BestEffort :SingleHost :Distributed)

# VerificationMethod subclasses
DisjointClasses(:HashVerification :ContentAddressing :PieceVerification :DigitalSignature :NoVerification)

############################
#   Restriction Axioms
############################

# AccessDescription: exactly 1 protocol
SubClassOf(:AccessDescription ObjectExactCardinality(1 :protocol :Protocol))

# AccessDescription: at least 1 authentication scheme
SubClassOf(:AccessDescription ObjectSomeValuesFrom(:authenticationScheme :AuthenticationScheme))

# AccessDescription: at least 1 supported operation
SubClassOf(:AccessDescription ObjectSomeValuesFrom(:supportedOperation :Operation))

# YieldDescription: exactly 1 delivery mode
SubClassOf(:YieldDescription ObjectExactCardinality(1 :deliveryMode :DeliveryMode))

# YieldDescription: at most 1 temporal quality
SubClassOf(:YieldDescription ObjectMaxCardinality(1 :temporalQuality :TemporalQuality))

# YieldDescription: at most 1 coverage
SubClassOf(:YieldDescription ObjectMaxCardinality(1 :coverage :Coverage))


)
