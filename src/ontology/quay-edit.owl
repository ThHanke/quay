#   Restriction Axioms
############################

# AccessDescription: exactly 1 protocol
SubClassOf(:QUAY_0000001 ObjectExactCardinality(1 :QUAY_0000048 :QUAY_0000003))

# AccessDescription: at least 1 authentication scheme
