AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/SshProtocol> "Protocol that provides encrypted file transfer and remote command execution over a Secure Shell connection.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/SshProtocol> "SSH/SFTP")
SubClassOf(<https://w3id.org/quay/SshProtocol> <https://w3id.org/quay/Protocol>)

# Class: <https://w3id.org/quay/StreamingDelivery> (Streaming Delivery)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/StreamingDelivery> "Delivery mode in which data is transferred as a continuous flow of incremental units over a persistent connection.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/StreamingDelivery> "Streaming Delivery")
SubClassOf(<https://w3id.org/quay/StreamingDelivery> <https://w3id.org/quay/DeliveryMode>)

# Class: <https://w3id.org/quay/SubsetCoverage> (Subset)

AnnotationAssertion(obo:IAO_0000115 <https://w3id.org/quay/SubsetCoverage> "Coverage in which the distribution contains a defined, criteria-based portion of the available data.")
AnnotationAssertion(rdfs:label <https://w3id.org/quay/SubsetCoverage> "Subset")
SubClassOf(<https://w3id.org/quay/SubsetCoverage> <https://w3id.org/quay/Coverage>)

