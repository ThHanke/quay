        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <obo:IAO_0000115>Number of independent copies of the data maintained across storage nodes.</obo:IAO_0000115>
        <rdfs:label>replication factor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/quay/retentionPeriod -->

