        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label>specializationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label>wasDerivedFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasInfluencedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInfluencedBy">
        <rdfs:label>wasInfluencedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasRevisionOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label>wasRevisionOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://xmlns.com/foaf/0.1/homepage -->

    <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
    


    <!-- https://w3id.org/quay/accessDescription -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/accessDescription">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/AccessDescription"/>
        <obo:IAO_0000115>Relates a distribution to a qualification node that describes how it is accessed.</obo:IAO_0000115>
        <rdfs:label>access description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/authenticationScheme -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/authenticationScheme">
        <rdfs:domain rdf:resource="https://w3id.org/quay/AccessDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/AuthenticationScheme"/>
        <obo:IAO_0000115>Relates an access description to the method used to verify the identity of the accessing agent.</obo:IAO_0000115>
        <rdfs:label>authentication scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/coverage -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/coverage">
        <rdfs:domain rdf:resource="https://w3id.org/quay/YieldDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/Coverage"/>
        <obo:IAO_0000115>Relates a yield description to the extent of dataset representation in the distribution.</obo:IAO_0000115>
        <rdfs:label>coverage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/deliveryMode -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/deliveryMode">
        <rdfs:domain rdf:resource="https://w3id.org/quay/YieldDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/DeliveryMode"/>
        <obo:IAO_0000115>Relates a yield description to the mechanism by which data is transferred to the consumer.</obo:IAO_0000115>
        <rdfs:label>delivery mode</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/encryptionAtRest -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/encryptionAtRest">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/EncryptionAlgorithm"/>
        <obo:IAO_0000115>Relates a distribution to the encryption algorithm applied to data at rest within the storage backend.</obo:IAO_0000115>
        <rdfs:label>encryption at rest</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/encryptionInTransit -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/encryptionInTransit">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/EncryptionAlgorithm"/>
        <obo:IAO_0000115>Relates a distribution to the encryption protocol applied to data during transfer between client and server.</obo:IAO_0000115>
        <rdfs:label>encryption in transit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/protocol -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/protocol">
        <rdfs:domain rdf:resource="https://w3id.org/quay/AccessDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/Protocol"/>
        <obo:IAO_0000115>Relates an access description to the communication protocol used for data exchange.</obo:IAO_0000115>
        <rdfs:label>protocol</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/serviceQuality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/serviceQuality">
        <rdfs:domain rdf:resource="https://w3id.org/quay/YieldDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/ServiceQuality"/>
        <obo:IAO_0000115>Relates a yield description to the reliability and availability characterisation of the service.</obo:IAO_0000115>
        <rdfs:label>service quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/storageJurisdiction -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/storageJurisdiction">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <obo:IAO_0000115>Relates a distribution to the legal jurisdiction or geographic region where data is physically stored.</obo:IAO_0000115>
        <rdfs:label>storage jurisdiction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/supportedOperation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/supportedOperation">
        <rdfs:domain rdf:resource="https://w3id.org/quay/AccessDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/Operation"/>
        <obo:IAO_0000115>Relates an access description to an action that can be performed on the data resource.</obo:IAO_0000115>
        <rdfs:label>supported operation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/temporalQuality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/temporalQuality">
        <rdfs:domain rdf:resource="https://w3id.org/quay/YieldDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/TemporalQuality"/>
        <obo:IAO_0000115>Relates a yield description to the freshness characterisation of the available data.</obo:IAO_0000115>
        <rdfs:label>temporal quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/verificationMethod -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/verificationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/quay/YieldDescription"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/VerificationMethod"/>
        <obo:IAO_0000115>Relates a yield description to the mechanism used to verify data integrity after transfer.</obo:IAO_0000115>
        <rdfs:label>verification method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/quay/yieldDescription -->

    <owl:ObjectProperty rdf:about="https://w3id.org/quay/yieldDescription">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="https://w3id.org/quay/YieldDescription"/>
        <obo:IAO_0000115>Relates a distribution to a qualification node that describes what it delivers.</obo:IAO_0000115>
        <rdfs:label>yield description</rdfs:label>
    </owl:ObjectProperty>
    


