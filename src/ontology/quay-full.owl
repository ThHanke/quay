        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <obo:IAO_0000115>Duration for which data is guaranteed to be retained before deletion or archival.</obo:IAO_0000115>
        <rdfs:label>retention period</rdfs:label>
    </owl:DatatypeProperty>
    


