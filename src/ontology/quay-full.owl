<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/quay/quay-full.owl#"
     xml:base="https://w3id.org/quay/quay-full.owl"
     xmlns:dce="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dcat="http://www.w3.org/ns/dcat#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:odrl="http://www.w3.org/ns/odrl/2/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfa="http://www.w3.org/ns/rdfa#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:void="http://rdfs.org/ns/void#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/quay/quay-full.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/quay/releases/2026-08-17/quay-full.owl"/>
        <dcterms:description>A DCAT Profile for Data Access, Storage and Authorization Metadata.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title>QUAY: Qualified Usage, Access and Yield</dcterms:title>
        <owl:versionInfo>2026-08-17</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/source"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/pav/hasVersion -->

    <owl:ObjectProperty rdf:about="http://purl.org/pav/hasVersion">
        <owl:equivalentProperty rdf:resource="http://www.w3.org/ns/dcat#hasVersion"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#accessService -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#accessService">
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:label xml:lang="en">data access service</rdfs:label>
        <rdfs:label xml:lang="da">dataadgangstjeneste</rdfs:label>
        <rdfs:label xml:lang="es">servicio de acceso de datos</rdfs:label>
        <rdfs:label xml:lang="it">servizio di accesso ai dati</rdfs:label>
        <rdfs:label xml:lang="cs">služba pro přístup k datům</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#accessURL -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#accessURL">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/ns/dcat#accessService"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/dcat#endpointURL"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="fr">URL d&apos;accès</rdfs:label>
        <rdfs:label xml:lang="es">URL de acceso</rdfs:label>
        <rdfs:label xml:lang="el">URL πρόσβασης</rdfs:label>
        <rdfs:label xml:lang="en">access address</rdfs:label>
        <rdfs:label xml:lang="da">adgangsadresse</rdfs:label>
        <rdfs:label xml:lang="it">indirizzo di accesso</rdfs:label>
        <rdfs:label xml:lang="cs">přístupová adresa</rdfs:label>
        <rdfs:label xml:lang="ar">رابط وصول</rdfs:label>
        <rdfs:label xml:lang="ja">アクセスURL</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#catalog -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#catalog">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/dcat#resource"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <rdfs:label xml:lang="en">catalog</rdfs:label>
        <rdfs:label xml:lang="it">catalogo</rdfs:label>
        <rdfs:label xml:lang="es">catálogo</rdfs:label>
        <rdfs:label xml:lang="cs">katalog</rdfs:label>
        <rdfs:label xml:lang="da">katalog</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#compressFormat -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#compressFormat">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/MediaType"/>
        <rdfs:label xml:lang="en">compression format</rdfs:label>
        <rdfs:label xml:lang="es">formato de compresión</rdfs:label>
        <rdfs:label xml:lang="it">formato di compressione</rdfs:label>
        <rdfs:label xml:lang="cs">formát komprese</rdfs:label>
        <rdfs:label xml:lang="da">kompressionsformat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#contactPoint -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#contactPoint">
        <rdfs:range rdf:resource="http://www.w3.org/2006/vcard/ns#Kind"/>
        <rdfs:label xml:lang="es">Punto de contacto</rdfs:label>
        <rdfs:label xml:lang="en">contact point</rdfs:label>
        <rdfs:label xml:lang="cs">kontaktní bod</rdfs:label>
        <rdfs:label xml:lang="da">kontaktpunkt</rdfs:label>
        <rdfs:label xml:lang="fr">point de contact</rdfs:label>
        <rdfs:label xml:lang="it">punto di contatto</rdfs:label>
        <rdfs:label xml:lang="el">σημείο επικοινωνίας</rdfs:label>
        <rdfs:label xml:lang="ar">عنوان اتصال</rdfs:label>
        <rdfs:label xml:lang="ja">窓口</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#dataset -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#dataset">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/dcat#resource"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:label xml:lang="es">conjunto de datos</rdfs:label>
        <rdfs:label xml:lang="en">dataset</rdfs:label>
        <rdfs:label xml:lang="it">dataset</rdfs:label>
        <rdfs:label xml:lang="da">datasæt</rdfs:label>
        <rdfs:label xml:lang="cs">datová sada</rdfs:label>
        <rdfs:label xml:lang="fr">jeu de données</rdfs:label>
        <rdfs:label xml:lang="el">σύνολο δεδομένων</rdfs:label>
        <rdfs:label xml:lang="ar">قائمة بيانات</rdfs:label>
        <rdfs:label xml:lang="ja">データセット</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#distribution -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#distribution">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/dcat#isDistributionOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:label xml:lang="cs">distribuce</rdfs:label>
        <rdfs:label xml:lang="es">distribución</rdfs:label>
        <rdfs:label xml:lang="da">distribution</rdfs:label>
        <rdfs:label xml:lang="en">distribution</rdfs:label>
        <rdfs:label xml:lang="fr">distribution</rdfs:label>
        <rdfs:label xml:lang="it">distribuzione</rdfs:label>
        <rdfs:label xml:lang="el">διανομή</rdfs:label>
        <rdfs:label xml:lang="ar">توزيع</rdfs:label>
        <rdfs:label xml:lang="ja">データセット配信</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#downloadURL -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#downloadURL">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:label xml:lang="es">URL de descarga</rdfs:label>
        <rdfs:label xml:lang="fr">URL de téléchargement</rdfs:label>
        <rdfs:label xml:lang="it">URL di scarico</rdfs:label>
        <rdfs:label xml:lang="cs">URL souboru ke stažení</rdfs:label>
        <rdfs:label xml:lang="el">URL μεταφόρτωσης</rdfs:label>
        <rdfs:label xml:lang="en">download URL</rdfs:label>
        <rdfs:label xml:lang="da">downloadURL</rdfs:label>
        <rdfs:label xml:lang="ar">رابط تحميل</rdfs:label>
        <rdfs:label xml:lang="ja">ダウンロードURL</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#endpointDescription -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#endpointDescription">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:label xml:lang="es">descripción del end-point del servicio</rdfs:label>
        <rdfs:label xml:lang="en">description of service end-point</rdfs:label>
        <rdfs:label xml:lang="it">descrizione dell&apos;endpoint del servizio</rdfs:label>
        <rdfs:label xml:lang="da">endpointbeskrivelse</rdfs:label>
        <rdfs:label xml:lang="cs">popis přístupového bodu služby</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#endpointURL -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#endpointURL">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:label xml:lang="es">end-point del servicio</rdfs:label>
        <rdfs:label xml:lang="it">end-point del servizio</rdfs:label>
        <rdfs:label xml:lang="cs">přístupový bod služby</rdfs:label>
        <rdfs:label xml:lang="en">service end-point</rdfs:label>
        <rdfs:label xml:lang="da">tjenesteendpoint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#hasCurrentVersion -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#hasCurrentVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/pav/hasVersion"/>
        <rdfs:label xml:lang="it">ha versione attuale</rdfs:label>
        <rdfs:label xml:lang="en">has current version</rdfs:label>
        <rdfs:label xml:lang="es">tiene versión actual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#hasVersion -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#hasVersion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generalizationOf"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/dcat#isVersionOf"/>
        <rdfs:label xml:lang="it">ha versione</rdfs:label>
        <rdfs:label xml:lang="en">has version</rdfs:label>
        <rdfs:label xml:lang="es">tiene versión</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#inCatalog -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#inCatalog">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/dcat#resource"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#inSeries -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#inSeries">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/dcat#seriesMember"/>
        <rdfs:label xml:lang="es">en serie</rdfs:label>
        <rdfs:label xml:lang="it">in serie</rdfs:label>
        <rdfs:label xml:lang="en">in series</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#isDistributionOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#isDistributionOf"/>
    


    <!-- http://www.w3.org/ns/dcat#isVersionOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#isVersionOf"/>
    


    <!-- http://www.w3.org/ns/dcat#mediaType -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#mediaType">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/MediaType"/>
        <rdfs:label xml:lang="en">media type</rdfs:label>
        <rdfs:label xml:lang="da">medietype</rdfs:label>
        <rdfs:label xml:lang="es">tipo de media</rdfs:label>
        <rdfs:label xml:lang="it">tipo di media</rdfs:label>
        <rdfs:label xml:lang="cs">typ média</rdfs:label>
        <rdfs:label xml:lang="fr">type de média</rdfs:label>
        <rdfs:label xml:lang="el">τύπος μέσου</rdfs:label>
        <rdfs:label xml:lang="ar">نوع الميديا</rdfs:label>
        <rdfs:label xml:lang="ja">メディア・タイプ</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#nextVersion -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#nextVersion">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/dcat#previousVersion"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#packageFormat -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#packageFormat">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/MediaType"/>
        <rdfs:label xml:lang="es">formato de empaquetado</rdfs:label>
        <rdfs:label xml:lang="it">formato di impacchettamento</rdfs:label>
        <rdfs:label xml:lang="cs">formát balíčku</rdfs:label>
        <rdfs:label xml:lang="en">packaging format</rdfs:label>
        <rdfs:label xml:lang="da">pakkeformat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#previousVersion -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#previousVersion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
        <rdfs:label xml:lang="en">previous version</rdfs:label>
        <rdfs:label xml:lang="it">versione precedente</rdfs:label>
        <rdfs:label xml:lang="es">versión anterior</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#resource -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#resource">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:label xml:lang="en">resource</rdfs:label>
        <rdfs:label xml:lang="it">risorsa</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#seriesMember -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#seriesMember"/>
    


    <!-- http://www.w3.org/ns/dcat#servesDataset -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#servesDataset">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:label xml:lang="da">datatjeneste for datasæt</rdfs:label>
        <rdfs:label xml:lang="cs">poskytuje datovou sadu</rdfs:label>
        <rdfs:label xml:lang="es">provee conjunto de datos</rdfs:label>
        <rdfs:label xml:lang="it">serve set di dati</rdfs:label>
        <rdfs:label xml:lang="en">serves dataset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#service -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#service">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/dcat#resource"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:label xml:lang="da">datatjeneste</rdfs:label>
        <rdfs:label xml:lang="en">service</rdfs:label>
        <rdfs:label xml:lang="es">servicio</rdfs:label>
        <rdfs:label xml:lang="it">servizio</rdfs:label>
        <rdfs:label xml:lang="cs">služba</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#theme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#theme">
        <rdfs:label xml:lang="da">emne</rdfs:label>
        <rdfs:label xml:lang="es">tema</rdfs:label>
        <rdfs:label xml:lang="it">tema</rdfs:label>
        <rdfs:label xml:lang="en">theme</rdfs:label>
        <rdfs:label xml:lang="fr">thème</rdfs:label>
        <rdfs:label xml:lang="cs">téma</rdfs:label>
        <rdfs:label xml:lang="el">Θέμα</rdfs:label>
        <rdfs:label xml:lang="ar">التصنيف</rdfs:label>
        <rdfs:label xml:lang="ja">テーマ/カテゴリー</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/action -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/action">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/odrl/2/Policy"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/odrl/2/Rule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/constraint -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/constraint">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/odrl/2/Policy"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/odrl/2/Rule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/odrl/2/Constraint"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/odrl/2/LogicalConstraint"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/duty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/duty">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Permission"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/hasPolicy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/hasPolicy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/includedIn -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/includedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/obligation -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/obligation">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/permission -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/permission">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Permission"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/prohibition -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/prohibition">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Prohibition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/relation -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/relation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
