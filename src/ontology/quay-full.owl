    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/quay/AccessDescription"/>
            <rdf:Description rdf:about="https://w3id.org/quay/AuthenticationScheme"/>
            <rdf:Description rdf:about="https://w3id.org/quay/Coverage"/>
            <rdf:Description rdf:about="https://w3id.org/quay/DeliveryMode"/>
            <rdf:Description rdf:about="https://w3id.org/quay/EncryptionAlgorithm"/>
            <rdf:Description rdf:about="https://w3id.org/quay/Operation"/>
            <rdf:Description rdf:about="https://w3id.org/quay/Protocol"/>
            <rdf:Description rdf:about="https://w3id.org/quay/ServiceQuality"/>
            <rdf:Description rdf:about="https://w3id.org/quay/TemporalQuality"/>
            <rdf:Description rdf:about="https://w3id.org/quay/VerificationMethod"/>
            <rdf:Description rdf:about="https://w3id.org/quay/YieldDescription"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/quay/Aes128Encryption"/>
            <rdf:Description rdf:about="https://w3id.org/quay/Aes256Encryption"/>
            <rdf:Description rdf:about="https://w3id.org/quay/GpgEncryption"/>
            <rdf:Description rdf:about="https://w3id.org/quay/NoEncryption"/>
            <rdf:Description rdf:about="https://w3id.org/quay/SshEncryption"/>
            <rdf:Description rdf:about="https://w3id.org/quay/Tls12Encryption"/>
            <rdf:Description rdf:about="https://w3id.org/quay/Tls13Encryption"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
